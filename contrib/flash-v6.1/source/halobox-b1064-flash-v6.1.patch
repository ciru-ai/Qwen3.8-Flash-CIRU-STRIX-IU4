+    __shared__ uint64_t prefix[512];
+    const int e = threadIdx.x;
+    for (int i = e; i < cold_capacity; i += blockDim.x) cold[i] = UINT32_MAX;
+    for (int i = e; i < hot_capacity; i += blockDim.x) hot[i] = UINT32_MAX;
+    if (small) small[e] = UINT32_MAX;
+
+    const int rows = bounds[e + 1] - bounds[e];
+    const int cold_n = rows >= 32 && rows < 1024 ? (rows + 63) / 64 : 0;
+    const int hot_n = rows >= 1024 ? (rows + 127) / 128 : 0;
+    const int small_n = small && rows > 0 && rows < 32;
+    const uint64_t counts = uint64_t(cold_n) | (uint64_t(hot_n) << 16) | (uint64_t(small_n) << 32);
+    prefix[e] = counts;
+    __syncthreads();
+    for (int stride = 1; stride < 512; stride *= 2) {
+        const uint64_t add = e >= stride ? prefix[e - stride] : 0;
+        __syncthreads();
+        prefix[e] += add;
+        __syncthreads();
+    }
+    const uint64_t begin = prefix[e] - counts;
+    const int cold_begin = int(begin & 0xffff);
+    const int hot_begin = int((begin >> 16) & 0xffff);
+    for (int j = 0; j < cold_n; ++j) cold[cold_begin + j] = uint32_t(e) | (uint32_t(j) << 16);
+    for (int j = 0; j < hot_n; ++j) hot[hot_begin + j] = uint32_t(e) | (uint32_t(j) << 16);
+    if (small_n) small[begin >> 32] = uint32_t(e);
+}
+
+// Eight waves each own 16 features and eight 16-token WMMA fragments. The
+// C1 decoder, accumulator order, BF16 conversion and row maps match R2.
+static __global__ __launch_bounds__(256)
+void mmb_c1_hot_down_128(const uint8_t * __restrict__ weights, size_t expert_bytes,
+        const uint16_t * __restrict__ rows, const uint32_t * __restrict__ tables,
+        const uint16_t * __restrict__ x, float * output, uint16_t * output_bf16,
+        const int32_t * __restrict__ source, const int32_t * __restrict__ destination,
+        const int32_t * __restrict__ bounds, const uint32_t * __restrict__ descriptors) {
+    constexpr int K = 640, M = 2560, Tokens = 128, Features = 128, Stage = 64, Stride = Stage + 8;
+    __shared__ __align__(16) uint16_t activation[2][Tokens][Stride];
+    __shared__ uint32_t affine[256];
+
+    const uint32_t descriptor = descriptors[blockIdx.y];
+    if (descriptor == UINT32_MAX) return;
+    const int expert = descriptor & 0xffff;
+    const int route = bounds[expert] + int(descriptor >> 16) * Tokens;
+    const int active = min(Tokens, bounds[expert + 1] - route);
+    const int tid = threadIdx.x, lane = tid & 31, wave = tid >> 5, sub = lane & 15;
+    const int feature = blockIdx.x * Features + wave * 16 + sub;
+    affine[tid] = tables[size_t(expert) * 256 + tid];
+    const uint8_t * bank = weights + size_t(expert) * expert_bytes;
+    const uint16_t row_scale = rows[size_t(expert) * M + feature];
+
+    const uint16_t * source_rows[4];
+#pragma unroll
+    for (int i = 0; i < 4; ++i) {
+        const int item = tid + i * 256, token = item / 8;
+        const int sr = token < active ? source[route + token] : -1;
+        source_rows[i] = sr < 0 ? nullptr : x + size_t(sr) * K + (item % 8) * 8;
+    }
+    uint4 input[4];
+    auto load_input = [&](int slice) {
+#pragma unroll
+        for (int i = 0; i < 4; ++i) {
+            input[i] = source_rows[i] ? *reinterpret_cast<const uint4 *>(source_rows[i] + slice * Stage)
+                                      : make_uint4(0, 0, 0, 0);
+        }
+    };
+    auto stage_input = [&](int slot) {
+#pragma unroll
+        for (int i = 0; i < 4; ++i) {
+            const int item = tid + i * 256;
+            *reinterpret_cast<uint4 *>(&activation[slot][item / 8][(item % 8) * 8]) = input[i];
+        }
+    };
+
+    v8f acc[8] = {};
+    load_input(0);
+    stage_input(0);
+    __syncthreads();
+#pragma clang loop unroll(disable)
+    for (int slice = 0; slice < K / Stage; ++slice) {
+        if (slice + 1 < K / Stage) load_input(slice + 1);
+        const auto offset = c1_slice<true>(feature, slice, K, K / 2 + K / 16);
+        const uint4 lo = mmb_c1_load16(bank + offset.codes);
+        const uint4 hi = mmb_c1_load16(bank + offset.codes + 16);
+        const uint2 codes[4] = {make_uint2(lo.x, lo.y), make_uint2(lo.z, lo.w),
+                                make_uint2(hi.x, hi.y), make_uint2(hi.z, hi.w)};
+        const uint32_t indices = *reinterpret_cast<const uint32_t *>(bank + offset.indices);
+#pragma unroll
+        for (int group = 0; group < 4; ++group) {
+            uint32_t decoded[8];
+            mmb_dq_group_c1(codes[group], uint8_t(indices >> (group * 8)), row_scale, affine, decoded);
+            const v16s w = __builtin_bit_cast(v16s, decoded);
+#pragma unroll
+            for (int j = 0; j < 8; ++j) {
+                if (j * 16 >= active) continue;
+                const auto * a = reinterpret_cast<const uint4 *>(&activation[slice & 1][j * 16 + sub][group * 16]);
+                const uint4 parts[2] = { a[0], a[1] };
+                const v16s in = __builtin_bit_cast(v16s, parts);
+                acc[j] = __builtin_amdgcn_wmma_f32_16x16x16_bf16_w32(in, w, acc[j]);
+            }
+        }
+        if (slice + 1 < K / Stage) {
+            stage_input((slice + 1) & 1);
+            __syncthreads();
+        }
+    }
+
+#pragma unroll
+    for (int j = 0; j < 8; ++j) {
+#pragma unroll
+        for (int v = 0; v < 8; ++v) {
+            const int token = j * 16 + 2 * v + (lane >> 4);
+            if (token >= active) continue;
+            const int dr = destination[route + token];
+            if (dr < 0) continue;
+            const size_t dst = size_t(dr) * M + feature;
+            if (output_bf16) output_bf16[dst] = mmb_f2bf(acc[j][v]);
+            else output[dst] = acc[j][v];
+        }
+    }
+}
