diff --git a/ggml/src/ggml-cuda/c1-chain-gate.cuh b/ggml/src/ggml-cuda/c1-chain-gate.cuh
new file mode 100644
index 0000000000000000000000000000000000000000..9e9d8f97af9afbb793135f8fc21c361763aa3ba2
--- /dev/null
+++ b/ggml/src/ggml-cuda/c1-chain-gate.cuh
@@ -0,0 +1,126 @@
+// gfx1151, tiled C1 BF16 gate/up. Each wave holds eight gate rows and the
+// matching eight up rows. Each decoded K16 serves up to 128 routed tokens.
+static __global__ __launch_bounds__(256) void mmb_routed_c1_chain_gate(
+        const uint8_t * Wg, const uint8_t * Wu, size_t expert_bytes,
+        const uint16_t * grows, const uint16_t * urows,
+        const uint32_t * gtables, const uint32_t * utables,
+        const uint16_t * Xh, float * D, uint16_t * Dh, bool store_f32,
+        const int32_t * ids_src, const int32_t * ids_dst, const int32_t * bounds,
+        const uint32_t * desc, int M, int K) {
+#if defined(__HIP_DEVICE_COMPILE__) && !defined(RDNA3)
+    NO_DEVICE_CODE;
+#else
+    constexpr int tokens = 128, features = 64, stripes = tokens / 16;
+    const uint32_t tile = desc[blockIdx.y];
+    if (tile == UINT32_MAX) return;
+    const int expert = tile & 0xffff;
+    const int start = bounds[expert] + (tile >> 16) * tokens;
+    const int count = min(tokens, bounds[expert + 1] - start);
+    const int fragments = (count + 15) / 16;
+    const int tid = threadIdx.x, wave = tid >> 5, lane = tid & 31, sub = lane & 15;
+    const int first_feature = blockIdx.x * features;
+    const int feature = first_feature + wave * 8 + (sub & 7);
+    const bool gate = sub < 8;
+    const int piece = mmb_ms_piece(lane);
+    const uint8_t *bank = (gate ? Wg : Wu) + size_t(expert) * expert_bytes;
+    const uint16_t scale = (gate ? grows : urows)[size_t(expert) * M + feature];
+    __shared__ uint32_t tables[2][256];
+    tables[0][tid] = gtables[size_t(expert) * 256 + tid];
+    tables[1][tid] = utables[size_t(expert) * 256 + tid];
+    // Padded fragment-major activation tiles occupy 16.1 KiB. Reuse that
+    // storage for a coalesced BF16 row epilogue once all K steps finish.
+    union alignas(16) Scratch {
+        uint4 activation[8][tokens + 1];
+        uint16_t output[tokens][features + 2];
+    };
+    __shared__ Scratch scratch;
+    uint4 packet0, packet1, packet2, packet3;
+    const uint16_t *sources[4];
+#pragma unroll
+    for (int i = 0; i < 4; ++i) {
+        const int chunk = tid + i * 256;
+        const int token = chunk / 8;
+        const int source = ids_src[start + min(token, count - 1)];
+        sources[i] = Xh + size_t(max(0, source)) * K + (chunk % 8) * 8;
+    }
+    uint2 codes[2];
+    uint32_t indices;
+    auto fetch = [&](int step) {
+        const auto offsets = c1_slice<true>(feature, step, K, size_t(K / 2 + K / 16));
+        indices = *reinterpret_cast<const uint32_t *>(bank + offsets.indices);
+#pragma unroll
+        for (int q = 0; q < 2; ++q)
+            codes[q] = mmb_c1_load8(bank + offsets.codes + (2 * q + piece) * 8);
+        packet0 = *reinterpret_cast<const uint4 *>(sources[0] + step * 64);
+        packet1 = *reinterpret_cast<const uint4 *>(sources[1] + step * 64);
+        packet2 = *reinterpret_cast<const uint4 *>(sources[2] + step * 64);
+        packet3 = *reinterpret_cast<const uint4 *>(sources[3] + step * 64);
+    };
+    v8f acc[stripes]{};
+    fetch(0);
+    for (int step = 0; step < K / 64; ++step) {
+        // One packet per 32-token band. Its K8 stripe and within-band
+        // row equal the original chunk % 8 and chunk / 8 expressions.
+        const int stripe = tid % 8, row = tid / 8;
+        scratch.activation[stripe][row]      = packet0;
+        scratch.activation[stripe][row + 32] = packet1;
+        scratch.activation[stripe][row + 64] = packet2;
+        scratch.activation[stripe][row + 96] = packet3;
+        __syncthreads();
+        mmb_v8u weights[2];
+#pragma unroll
+        for (int q = 0; q < 2; ++q) {
+            uint32_t decoded[8];
+            const int group = 2 * q + piece;
+            mmb_dq_group_c1(codes[q], uint8_t(indices >> (8 * group)), scale,
+                            tables[gate ? 0 : 1], decoded);
+            __builtin_memcpy(&weights[q], decoded, sizeof(decoded));
+        }
+        if (step + 1 < K / 64) fetch(step + 1);
+#pragma unroll
+        for (int q = 0; q < 2; ++q) {
+            const mmb_v8u peer = mmb_ms_xhalf(weights[q]);
+#pragma unroll
+            for (int j = 0; j < stripes; ++j) {
+                if (j >= fragments) continue;
+                asm volatile("" ::: "memory");
+                const int token = j * 16 + sub;
+                const uint4 a = scratch.activation[q * 4][token];
+                const uint4 b = scratch.activation[q * 4 + 1][token];
+                const uint4 c = scratch.activation[q * 4 + 2][token];
+                const uint4 d = scratch.activation[q * 4 + 3][token];
+                acc[j] = mmb_wmma_bf16_u(weights[q], mmb_v8u{a.x,a.y,a.z,a.w,b.x,b.y,b.z,b.w}, acc[j]);
+                acc[j] = mmb_wmma_bf16_u(peer, mmb_v8u{c.x,c.y,c.z,c.w,d.x,d.y,d.z,d.w}, acc[j]);
+            }
+        }
+        __syncthreads();
+    }
+#pragma unroll
+    for (int j = 0; j < stripes; ++j) {
+        const int token = j * 16 + sub;
+        if (token >= count) continue;
+        const int dest = store_f32 ? ids_dst[start + token] : -1;
+#pragma unroll
+        for (int v = 0; v < 4; ++v) {
+            const int col = wave * 8 + 2 * v + (lane >> 4);
+            const float value = ggml_cuda_op_silu_single(acc[j][v]) * acc[j][v + 4];
+            scratch.output[token][col] = mmb_f2bf(value);
+            if (dest >= 0) D[size_t(dest) * M + first_feature + col] = value;
+        }
+    }
+    __syncthreads();
+    if (Dh) {
+#pragma unroll
+        for (int i = 0; i < 4; ++i) {
+            const int chunk = tid + i * 256, token = chunk / 8;
+            if (token >= count) continue;
+            const int dest = ids_dst[start + token];
+            if (dest < 0) continue;
+            const int col = (chunk % 8) * 8;
+            uint4 values;
+            __builtin_memcpy(&values, &scratch.output[token][col], sizeof(values));
+            *reinterpret_cast<uint4 *>(Dh + size_t(dest) * M + first_feature + col) = values;
+        }
+    }
+#endif
+}
diff --git a/ggml/src/ggml-cuda/c1-grouped.cuh b/ggml/src/ggml-cuda/c1-grouped.cuh
new file mode 100644
index 0000000000000000000000000000000000000000..12ca0367baae6a4c6a31d31c2cb1b4cda3ef12e6
--- /dev/null
+++ b/ggml/src/ggml-cuda/c1-grouped.cuh
@@ -0,0 +1,293 @@
+#pragma once
+
+// Experimental Strix Halo C1 grouped projection for MUL_MAT_ID with more
+// than eight tokens. Four N16 waves share each per-expert table per CTA.
+// The frozen 4.5175-bpw GGUF values are consumed directly:
+// main tensor = per-output-row [K/2 packed codes][K/16 table indices], plus
+// separate FP16 row multipliers and FP16 affine tables. The same packed
+// activation is used by the IU4 and same-value IU8 arms.
+//
+// Include this after C1PackedQ8K32Split and c1_pack_q8_runtime in c1.cu.
+
+#if defined(__HIP_PLATFORM_AMD__)
+namespace c1_grouped {
+
+using i32x2 = int __attribute__((ext_vector_type(2)));
+using i32x4 = int __attribute__((ext_vector_type(4)));
+using i32x8 = int __attribute__((ext_vector_type(8)));
+
+struct AffinePair { half d, m; };
+static_assert(sizeof(AffinePair) == 4);
+
+static __device__ __forceinline__ uint32_t unpack4(uint32_t v) {
+    return (v & 0x000fu) | ((v & 0x00f0u) << 4) |
+           ((v & 0x0f00u) << 8) | ((v & 0xf000u) << 12);
+}
+static __device__ __forceinline__ uint32_t unpack_centered4(uint32_t v) {
+    uint32_t bytes = unpack4(v ^ 0x8888u);
+    const uint32_t sign = bytes & 0x08080808u;
+    bytes |= (sign << 1) | (sign << 2) | (sign << 3) | (sign << 4);
+    return bytes;
+}
+static __device__ __forceinline__ uint32_t restore_q8(uint32_t l, uint32_t h) {
+    return unpack4(l) | (unpack4(h) << 4);
+}
+
+// A K32 group has two adjacent K16 table indices per output row. The run()
+// alignment guard and even C1 row strides make this a legal halfword load.
+static __device__ __forceinline__ uint16_t load_index_pair(const uint8_t * source) {
+    uint16_t pair;
+    __builtin_memcpy(&pair, __builtin_assume_aligned(source, alignof(uint16_t)), sizeof(pair));
+    return pair;
+}
+
+template<bool NativeIU4, bool Centered>
+static __device__ __forceinline__ i32x8 contract(uint32_t w0, uint32_t w1,
+        uint32_t l0, uint32_t l1, uint32_t h0, uint32_t h1) {
+    i32x8 dot = {};
+    if constexpr (NativeIU4) {
+        const i32x2 w = {int(Centered ? w0 ^ 0x88888888u : w0),
+                         int(Centered ? w1 ^ 0x88888888u : w1)};
+        const i32x2 hi = {int(h0), int(h1)};
+        const i32x2 lo = {int(l0), int(l1)};
+        dot = __builtin_amdgcn_wmma_i32_16x16x16_iu4_w32(Centered, w, true, hi, dot, false);
+#pragma unroll
+        for (int i = 0; i < 8; ++i) dot[i] *= 16;
+        dot = __builtin_amdgcn_wmma_i32_16x16x16_iu4_w32(Centered, w, false, lo, dot, false);
+    } else {
+        const i32x4 w = {int(Centered ? unpack_centered4(w0) : unpack4(w0)),
+                         int(Centered ? unpack_centered4(w0 >> 16) : unpack4(w0 >> 16)),
+                         int(Centered ? unpack_centered4(w1) : unpack4(w1)),
+                         int(Centered ? unpack_centered4(w1 >> 16) : unpack4(w1 >> 16))};
+        const i32x4 x = {int(restore_q8(l0, h0)), int(restore_q8(l0 >> 16, h0 >> 16)),
+                         int(restore_q8(l1, h1)), int(restore_q8(l1 >> 16, h1 >> 16))};
+        dot = __builtin_amdgcn_wmma_i32_16x16x16_iu8_w32(Centered, w, true, x, dot, false);
+    }
+    return dot;
+}
+
+static __global__ void route_count(const int32_t * ids, uint32_t * count,
+        int all_routes, int routes_per_token, int ids_token_stride, int experts) {
+    const unsigned route = blockIdx.x * blockDim.x + threadIdx.x;
+    if (route >= unsigned(all_routes)) return;
+    const int expert = ids[(route / routes_per_token) * ids_token_stride + route % routes_per_token];
+    if (expert >= 0 && expert < experts) atomicAdd(count + expert, 1u);
+}
+
+static __global__ __launch_bounds__(32) void route_describe(
+        const uint32_t * count, uint32_t * cursor, uint32_t * prefix,
+        int32_t * tile_expert, int32_t * tile_active, uint32_t * total,
+        int experts, int capacity) {
+    if (threadIdx.x) return;
+    unsigned next = 0;
+    for (int expert = 0; expert < experts; ++expert) {
+        const unsigned n = count[expert];
+        const unsigned tiles = (n + 15) / 16;
+        prefix[expert] = next;
+        cursor[expert] = 0;
+        for (unsigned t = 0; t < tiles && next + t < unsigned(capacity); ++t) {
+            tile_expert[next + t] = expert;
+            tile_active[next + t] = int(n - t * 16 < 16 ? n - t * 16 : 16);
+        }
+        next += tiles;
+    }
+    for (unsigned t = next; t < unsigned(capacity); ++t) {
+        tile_expert[t] = -1;
+        tile_active[t] = 0;
+    }
+    *total = next;
+}
+
+static __global__ void route_scatter(const int32_t * ids,
+        const uint32_t * prefix, uint32_t * cursor,
+        int32_t * slot_for_row, int all_routes, int routes_per_token,
+        int ids_token_stride, int experts) {
+    const unsigned route = blockIdx.x * blockDim.x + threadIdx.x;
+    if (route >= unsigned(all_routes)) return;
+    const int expert = ids[(route / routes_per_token) * ids_token_stride + route % routes_per_token];
+    if (expert < 0 || expert >= experts) return;
+    const unsigned ordinal = atomicAdd(cursor + expert, 1u);
+    const unsigned row = (prefix[expert] + ordinal / 16) * 16 + ordinal % 16;
+    slot_for_row[row] = int(route);
+}
+
+template<int K, int N, bool NativeIU4, bool Centered, bool TILED>
+static __global__ __launch_bounds__(128) void project(
+        const uint8_t * __restrict__ main,
+        const half * __restrict__ row_scales,
+        const half * __restrict__ tables,
+        const C1PackedQ8K32Split * __restrict__ activation,
+        const int32_t * __restrict__ tile_expert,
+        const int32_t * __restrict__ tile_active,
+        const int32_t * __restrict__ slot_for_row,
+        float * __restrict__ output,
+        int capacity, int experts, int routes, int input_channels,
+        size_t main_expert_stride, size_t row_expert_stride,
+        size_t table_expert_stride) {
+    constexpr int G16 = K / 16, G32 = K / 32;
+    constexpr int CodeRowBytes = K / 2;
+    constexpr int MainRowBytes = K / 2 + K / 16;
+    static_assert(CodeRowBytes % 2 == 0 && MainRowBytes % 2 == 0);
+    const unsigned thread = threadIdx.x;
+    const unsigned lane = thread & 31;
+    const unsigned wave = thread >> 5;
+    const unsigned lane16 = lane & 15, half_lane = lane >> 4;
+    const unsigned tile_n = blockIdx.x * 4 + wave, tile_m = blockIdx.y;
+    if (tile_m >= unsigned(capacity)) return;
+    const int expert = tile_expert[tile_m], active = tile_active[tile_m];
+    if (expert < 0 || expert >= experts || active <= 0) return;
+    const uint8_t * expert_main = main + size_t(expert) * main_expert_stride;
+    const half * expert_rows = reinterpret_cast<const half *>(
+        reinterpret_cast<const uint8_t *>(row_scales) + size_t(expert) * row_expert_stride);
+    const uint32_t * expert_table = reinterpret_cast<const uint32_t *>(
+        reinterpret_cast<const uint8_t *>(tables) + size_t(expert) * table_expert_stride);
+    __shared__ uint32_t table_shared[256];
+#pragma unroll
+    for (int i = 0; i < 2; ++i) table_shared[thread + 128 * i] = expert_table[thread + 128 * i];
+    __syncthreads();
+
+    const unsigned feature_lane = tile_n * 16 + lane16;
+    const unsigned grouped_row = tile_m * 16 + lane16;
+    const int slot = lane16 < unsigned(active) ? slot_for_row[grouped_row] : 0;
+    const int token = slot / routes, route = slot % routes;
+    const unsigned input_row = unsigned(token * input_channels + route % input_channels);
+    float totals[8] = {}, scales[8];
+#pragma unroll
+    for (int i = 0; i < 8; ++i) {
+        const unsigned feature = tile_n * 16 + 2 * i + half_lane;
+        scales[i] = float(expert_rows[feature]);
+    }
+#pragma clang loop unroll(disable)
+    for (unsigned g = 0; g < G32; ++g) {
+        // Submit eight halfword index loads before the WMMA and table lookup.
+        // Keeping the active-lane predicate avoids fetching unused rows in a
+        // partially occupied routed tile. The loaded values are used by both
+        // h iterations, so this does not alter the F32 accumulation order.
+        uint16_t index_pairs[8];
+        if (lane16 < unsigned(active)) {
+#pragma unroll
+            for (int i = 0; i < 8; ++i) {
+                const unsigned feature = tile_n * 16 + 2 * i + half_lane;
+                index_pairs[i] = load_index_pair(
+                    expert_main + c1_k16<TILED>(feature, 2 * g, K).indices);
+            }
+        }
+        const uint32_t * weight = reinterpret_cast<const uint32_t *>(
+            expert_main + c1_k16<TILED>(feature_lane, 2 * g, K).codes);
+        uint32_t w[4], lo[4] = {}, hi[4] = {};
+#pragma unroll
+        for (int j = 0; j < 4; ++j) w[j] = weight[j];
+        float dx = 0, sum0 = 0, sum1 = 0;
+        if (lane16 < unsigned(active)) {
+            const C1PackedQ8K32Split & a = activation[size_t(input_row) * G32 + g];
+            dx = float(a.d); sum0 = float(a.s0); sum1 = float(a.s1);
+#pragma unroll
+            for (int j = 0; j < 4; ++j) { lo[j] = a.low[j]; hi[j] = a.high[j]; }
+        }
+#pragma unroll
+        for (int h = 0; h < 2; ++h) {
+            const i32x8 dot = contract<NativeIU4, Centered>(
+                w[2 * h], w[2 * h + 1], lo[2 * h], lo[2 * h + 1],
+                hi[2 * h], hi[2 * h + 1]);
+#pragma unroll
+            for (int i = 0; i < 8; ++i) if (lane16 < unsigned(active)) {
+                const uint8_t index = uint8_t(index_pairs[i] >> (8 * h));
+                AffinePair pair;
+                const uint32_t bits = table_shared[index];
+                __builtin_memcpy(&pair, &bits, sizeof(bits));
+                const float s = h ? sum1 : sum0;
+                const float table_d = float(pair.d);
+                const float table_m = float(pair.m);
+                totals[i] += scales[i] * table_d * dx * float(dot[i])
+                           + scales[i] * (table_m + (Centered ? 8.0f * table_d : 0.0f)) * s;
+            }
+        }
+    }
+#pragma unroll
+    for (int i = 0; i < 8; ++i) if (lane16 < unsigned(active)) {
+        const unsigned feature = tile_n * 16 + 2 * i + half_lane;
+        output[size_t(slot) * N + feature] = totals[i];
+    }
+}
+
+static bool run(ggml_backend_cuda_context & ctx, ggml_tensor * dst,
+        bool same_value_iu8, bool centered) {
+    const ggml_tensor * w = dst->src[0], * x = dst->src[1], * ids = dst->src[2];
+    const ggml_tensor * rows = dst->src[3], * tables = dst->src[4];
+    const int tokens = int(dst->ne[2]), routes = int(dst->ne[1]);
+    const int experts = int(w->ne[2]), k = int(w->ne[0]), n = int(w->ne[1]);
+    const int input_channels = int(x->ne[1]);
+    if (tokens <= 8 || experts != 512 || routes <= 0 ||
+            (input_channels != 1 && input_channels != routes) ||
+            !ggml_is_contiguous(w) || !ggml_is_contiguous(x) ||
+            ids->nb[0] != sizeof(int32_t) || ids->nb[1] % sizeof(int32_t) != 0 ||
+            !ggml_is_contiguous(dst) ||
+            !ggml_is_contiguous(rows) || !ggml_is_contiguous(tables)) return false;
+    if (!((k == 2560 && n == 640) || (k == 640 && n == 2560))) return false;
+    if ((reinterpret_cast<uintptr_t>(w->data) & 1u) ||
+            (w->nb[1] & 1u) || (w->nb[2] & 1u)) return false;
+    const int all_routes = tokens * routes;
+    const int occupied_max = experts < all_routes ? experts : all_routes;
+    const int capacity = occupied_max + (all_routes - occupied_max) / 16;
+    const int groups32 = k / 32;
+    ggml_cuda_pool_alloc<uint32_t> count(ctx.pool(), experts);
+    ggml_cuda_pool_alloc<uint32_t> cursor(ctx.pool(), experts);
+    ggml_cuda_pool_alloc<uint32_t> prefix(ctx.pool(), experts);
+    ggml_cuda_pool_alloc<uint32_t> total(ctx.pool(), 1);
+    ggml_cuda_pool_alloc<int32_t> tile_expert(ctx.pool(), capacity);
+    ggml_cuda_pool_alloc<int32_t> tile_active(ctx.pool(), capacity);
+    ggml_cuda_pool_alloc<int32_t> slot_for_row(ctx.pool(), size_t(capacity) * 16);
+    ggml_cuda_pool_alloc<C1PackedQ8K32Split> activation(
+        ctx.pool(), size_t(groups32) * input_channels * tokens);
+    CUDA_CHECK(cudaMemsetAsync(count.ptr, 0, experts * sizeof(uint32_t), ctx.stream()));
+    const auto * selected = static_cast<const int32_t *>(ids->data);
+    const int ids_token_stride = int(ids->nb[1] / sizeof(int32_t));
+    route_count<<<(all_routes + 255) / 256, 256, 0, ctx.stream()>>>(
+        selected, count.ptr, all_routes, routes, ids_token_stride, experts);
+    route_describe<<<1, 32, 0, ctx.stream()>>>(
+        count.ptr, cursor.ptr, prefix.ptr, tile_expert.ptr, tile_active.ptr,
+        total.ptr, experts, capacity);
+    route_scatter<<<(all_routes + 255) / 256, 256, 0, ctx.stream()>>>(
+        selected, prefix.ptr, cursor.ptr, slot_for_row.ptr,
+        all_routes, routes, ids_token_stride, experts);
+    c1_pack_q8_runtime<<<(groups32 * input_channels * tokens + 255) / 256,
+        256, 0, ctx.stream()>>>(static_cast<const float *>(x->data),
+        activation.ptr, groups32, input_channels * tokens);
+    const dim3 grid(unsigned(n / 64), unsigned(capacity));
+    const bool tiled = ggml_cuda_c1_tiled(w);
+#define C1_GROUPED_LAUNCH(K, N, IU4, CENTERED) \
+    do { \
+        auto launch = [&](auto layout) { \
+        project<K, N, IU4, CENTERED, decltype(layout)::value><<<grid, 128, 0, ctx.stream()>>>( \
+            static_cast<const uint8_t *>(w->data), static_cast<const half *>(rows->data), \
+            static_cast<const half *>(tables->data), activation.ptr, \
+            tile_expert.ptr, tile_active.ptr, slot_for_row.ptr, \
+            static_cast<float *>(dst->data), capacity, experts, routes, input_channels, \
+            w->nb[2], rows->nb[1], tables->nb[2]); \
+        }; \
+        if (tiled) launch(std::true_type{}); else launch(std::false_type{}); \
+    } while (0)
+    if (k == 2560 && n == 640) {
+        if (same_value_iu8) {
+            if (centered) { C1_GROUPED_LAUNCH(2560, 640, false, true); }
+            else          { C1_GROUPED_LAUNCH(2560, 640, false, false); }
+        } else {
+            if (centered) { C1_GROUPED_LAUNCH(2560, 640, true, true); }
+            else          { C1_GROUPED_LAUNCH(2560, 640, true, false); }
+        }
+    } else {
+        if (same_value_iu8) {
+            if (centered) { C1_GROUPED_LAUNCH(640, 2560, false, true); }
+            else          { C1_GROUPED_LAUNCH(640, 2560, false, false); }
+        } else {
+            if (centered) { C1_GROUPED_LAUNCH(640, 2560, true, true); }
+            else          { C1_GROUPED_LAUNCH(640, 2560, true, false); }
+        }
+    }
+#undef C1_GROUPED_LAUNCH
+    CUDA_CHECK(cudaGetLastError());
+    return true;
+}
+
+} // namespace c1_grouped
+#endif
diff --git a/ggml/src/ggml-cuda/c1-vector-r4.cuh b/ggml/src/ggml-cuda/c1-vector-r4.cuh
new file mode 100644
index 0000000000000000000000000000000000000000..93d77352c9053520605449d1a19d32bdd56599ce
--- /dev/null
+++ b/ggml/src/ggml-cuda/c1-vector-r4.cuh
@@ -0,0 +1,227 @@
+// Four adjacent output rows share one activation packet and one wave.
+// Packet, correction, K16 assignment and each row's reduction match R1.
+template<int K, int N, bool NativeIU4, bool Centered, bool TILED>
+static __global__ __launch_bounds__(32) void c1_vector_r4_runtime(
+        const uint8_t * __restrict__ main, const half * __restrict__ rows,
+        const half * __restrict__ tables, const C1PackedQ8K32Split * __restrict__ activation,
+        const int32_t * __restrict__ ids, float * __restrict__ output,
+        int experts, int routes, int input_channels, int ids_token_stride) {
+    static_assert(N % 4 == 0);
+    constexpr int Groups16 = K / 16, Groups32 = K / 32;
+    constexpr int MainRowBytes = K / 2 + K / 16;
+    constexpr int MainExpertBytes = N * MainRowBytes;
+    const unsigned lane = threadIdx.x, group_n = blockIdx.x;
+    const unsigned route = blockIdx.y, token = blockIdx.z;
+    const int expert = ids[size_t(token) * ids_token_stride + route];
+    if (expert < 0 || expert >= experts) return;
+    const uint8_t * expert_main = main + size_t(expert) * MainExpertBytes;
+    const C1PackedQ8K32Split * x = activation +
+        (size_t(token) * input_channels + route % input_channels) * Groups32;
+    const half * table = tables + size_t(expert) * 512;
+    float total[4] = {}, scale[4];
+#pragma unroll
+    for (int row = 0; row < 4; ++row) {
+        scale[row] = float(rows[size_t(expert) * N + group_n * 4 + row]);
+    }
+#pragma clang loop unroll(disable)
+    for (unsigned g = lane; g < Groups16; g += 32) {
+        const unsigned half_group = g & 1, full_group = g >> 1;
+        const C1PackedQ8K32Split & a = x[full_group];
+        const uint32_t low0 = a.low[half_group * 2], low1 = a.low[half_group * 2 + 1];
+        const uint32_t high0 = a.high[half_group * 2], high1 = a.high[half_group * 2 + 1];
+        const float dx = float(a.d), sx = float(half_group ? a.s1 : a.s0);
+#pragma unroll
+        for (int row = 0; row < 4; ++row) {
+            const auto offsets = c1_k16<TILED>(group_n * 4 + row, g, K);
+            int dot = 0;
+#pragma unroll
+            for (int j = 0; j < 2; ++j) {
+                const uint32_t code = c1_load32(expert_main + offsets.codes + j * 4);
+                const uint32_t low = j ? low1 : low0, high = j ? high1 : high0;
+                if constexpr (NativeIU4) {
+                    const uint32_t w = Centered ? code ^ 0x88888888u : code;
+                    dot = __builtin_amdgcn_sudot8(Centered, int(w), false, int(low), dot, false);
+                    const int hi = __builtin_amdgcn_sudot8(Centered, int(w), true, int(high), 0, false);
+                    dot += 16 * hi;
+                } else {
+                    const uint32_t w0 = Centered ? c1_unpack_centered4(code & 0xffffu) : c1_unpack4(code & 0xffffu);
+                    const uint32_t w1 = Centered ? c1_unpack_centered4(code >> 16) : c1_unpack4(code >> 16);
+                    const uint32_t x0 = c1_restore_q8(low & 0xffffu, high & 0xffffu);
+                    const uint32_t x1 = c1_restore_q8(low >> 16, high >> 16);
+                    dot = __builtin_amdgcn_sudot4(Centered, int(w0), true, int(x0), dot, false);
+                    dot = __builtin_amdgcn_sudot4(Centered, int(w1), true, int(x1), dot, false);
+                }
+            }
+            const uint8_t index = expert_main[offsets.indices];
+            const float table_d = float(table[2 * unsigned(index)]);
+            const float table_m = float(table[2 * unsigned(index) + 1]);
+            const float d = scale[row] * table_d;
+            const float m = scale[row] * (table_m + (Centered ? 8.0f * table_d : 0.0f));
+            // Match the parent ISA: round the dot product, then FMA the sum correction.
+            total[row] += __builtin_fmaf(m, sx, (d * dx) * float(dot));
+        }
+    }
+#pragma unroll
+    for (unsigned offset = 16; offset > 0; offset >>= 1) {
+#pragma unroll
+        for (int row = 0; row < 4; ++row) {
+            const uint32_t bits = __builtin_bit_cast(uint32_t, total[row]);
+            const uint32_t peer = __builtin_amdgcn_ds_bpermute((lane ^ offset) * 4, bits);
+            total[row] += __builtin_bit_cast(float, peer);
+        }
+    }
+    if (lane == 0) {
+#pragma unroll
+        for (int row = 0; row < 4; ++row) {
+            output[(size_t(token) * routes + route) * N + group_n * 4 + row] = total[row];
+        }
+    }
+}
+
+// Short/decode discriminator: one CTA stages the expert LUT for four
+// otherwise independent R4 waves. The packet, four per-thread totals, K16
+// assignment, reduction, and output values have no format change.
+template<int K, int N, bool NativeIU4, bool Centered, bool TILED>
+static __global__ __launch_bounds__(128) void c1_vector_r4_lut_runtime(
+        const uint8_t * __restrict__ main, const half * __restrict__ rows,
+        const half * __restrict__ tables, const C1PackedQ8K32Split * __restrict__ activation,
+        const int32_t * __restrict__ ids, float * __restrict__ output,
+        int experts, int routes, int input_channels, int ids_token_stride) {
+    static_assert(N % 16 == 0);
+    constexpr int Groups16 = K / 16, Groups32 = K / 32;
+    constexpr int MainRowBytes = K / 2 + K / 16;
+    constexpr int MainExpertBytes = N * MainRowBytes;
+    const unsigned thread = threadIdx.x, lane = thread & 31, wave = thread >> 5;
+    const unsigned group_n = blockIdx.x * 4 + wave;
+    const unsigned route = blockIdx.y, token = blockIdx.z;
+    const int expert = ids[size_t(token) * ids_token_stride + route];
+    // Expert is CTA-uniform: every wave either stages its table or returns.
+    if (expert < 0 || expert >= experts) return;
+    const uint8_t * expert_main = main + size_t(expert) * MainExpertBytes;
+    const C1PackedQ8K32Split * x = activation +
+        (size_t(token) * input_channels + route % input_channels) * Groups32;
+    const half * table = tables + size_t(expert) * 512;
+    // Four independent R4 waves cooperate only on the expert LUT. Each
+    // thread stages two entries, once per 16-row CTA. This is 2 KiB of LDS.
+    struct Coeff { float d, m; };
+    __shared__ Coeff lut[256];
+#pragma unroll
+    for (unsigned part = 0; part < 2; ++part) {
+        const unsigned index = thread + part * 128;
+        const float d = float(table[2 * index]);
+        const float m = float(table[2 * index + 1]);
+        lut[index].d = d;
+        lut[index].m = m + (Centered ? 8.0f * d : 0.0f);
+    }
+    __syncthreads();
+    float total[4] = {}, scale[4];
+#pragma unroll
+    for (int row = 0; row < 4; ++row) {
+        scale[row] = float(rows[size_t(expert) * N + group_n * 4 + row]);
+    }
+#pragma clang loop unroll(disable)
+    for (unsigned g = lane; g < Groups16; g += 32) {
+        const unsigned half_group = g & 1, full_group = g >> 1;
+        const C1PackedQ8K32Split & a = x[full_group];
+        const uint32_t low0 = a.low[half_group * 2], low1 = a.low[half_group * 2 + 1];
+        const uint32_t high0 = a.high[half_group * 2], high1 = a.high[half_group * 2 + 1];
+        const float dx = float(a.d), sx = float(half_group ? a.s1 : a.s0);
+#pragma unroll
+        for (int row = 0; row < 4; ++row) {
+            const auto offsets = c1_k16<TILED>(group_n * 4 + row, g, K);
+            int dot = 0;
+#pragma unroll
+            for (int j = 0; j < 2; ++j) {
+                const uint32_t code = c1_load32(expert_main + offsets.codes + j * 4);
+                const uint32_t low = j ? low1 : low0, high = j ? high1 : high0;
+                if constexpr (NativeIU4) {
+                    const uint32_t w = Centered ? code ^ 0x88888888u : code;
+                    dot = __builtin_amdgcn_sudot8(Centered, int(w), false, int(low), dot, false);
+                    const int hi = __builtin_amdgcn_sudot8(Centered, int(w), true, int(high), 0, false);
+                    dot += 16 * hi;
+                } else {
+                    const uint32_t w0 = Centered ? c1_unpack_centered4(code & 0xffffu) : c1_unpack4(code & 0xffffu);
+                    const uint32_t w1 = Centered ? c1_unpack_centered4(code >> 16) : c1_unpack4(code >> 16);
+                    const uint32_t x0 = c1_restore_q8(low & 0xffffu, high & 0xffffu);
+                    const uint32_t x1 = c1_restore_q8(low >> 16, high >> 16);
+                    dot = __builtin_amdgcn_sudot4(Centered, int(w0), true, int(x0), dot, false);
+                    dot = __builtin_amdgcn_sudot4(Centered, int(w1), true, int(x1), dot, false);
+                }
+            }
+            const uint8_t index = expert_main[offsets.indices];
+            const Coeff coeff = lut[unsigned(index)];
+            const float d = scale[row] * coeff.d;
+            const float m = scale[row] * coeff.m;
+            // Match the parent ISA: round the dot product, then FMA the sum correction.
+            total[row] += __builtin_fmaf(m, sx, (d * dx) * float(dot));
+        }
+    }
+#pragma unroll
+    for (unsigned offset = 16; offset > 0; offset >>= 1) {
+#pragma unroll
+        for (int row = 0; row < 4; ++row) {
+            const uint32_t bits = __builtin_bit_cast(uint32_t, total[row]);
+            const uint32_t peer = __builtin_amdgcn_ds_bpermute((lane ^ offset) * 4, bits);
+            total[row] += __builtin_bit_cast(float, peer);
+        }
+    }
+    if (lane == 0) {
+#pragma unroll
+        for (int row = 0; row < 4; ++row) {
+            output[(size_t(token) * routes + route) * N + group_n * 4 + row] = total[row];
+        }
+    }
+}
+
+
+static bool c1_use_vector_r4_lut() {
+    static const bool enabled = [] {
+        const char * value = std::getenv("LLAMA_C1_VECTOR_R4_LUT");
+        const bool on = value && value[0] == '1';
+        if (on) std::fprintf(stderr, "C1 vector R4 LUT enabled (LLAMA_C1_VECTOR_R4_LUT=1)\n");
+        return on;
+    }();
+    return enabled;
+}
+
+static bool c1_use_vector_r4() {
+    static const bool enabled = [] {
+        const char * value = std::getenv("LLAMA_C1_VECTOR_R4");
+        const bool on = value && value[0] == '1';
+        if (on) std::fprintf(stderr, "C1 vector R4 enabled (LLAMA_C1_VECTOR_R4=1)\n");
+        return on;
+    }();
+    return enabled;
+}
+
+template<int K, int N, bool NativeIU4, bool Centered, bool TILED>
+static void c1_launch_vector_layout(ggml_backend_cuda_context & ctx, dim3 grid,
+        const uint8_t * main, const half * rows, const half * tables,
+        const C1PackedQ8K32Split * activation, const int32_t * ids, float * output,
+        int experts, int routes, int input_channels, int ids_token_stride) {
+    if (c1_use_vector_r4_lut()) {
+        grid.x /= 16;
+        c1_vector_r4_lut_runtime<K, N, NativeIU4, Centered, TILED><<<grid, 128, 0, ctx.stream()>>>(
+            main, rows, tables, activation, ids, output, experts, routes, input_channels, ids_token_stride);
+    } else if (c1_use_vector_r4()) {
+        grid.x /= 4;
+        c1_vector_r4_runtime<K, N, NativeIU4, Centered, TILED><<<grid, 32, 0, ctx.stream()>>>(
+            main, rows, tables, activation, ids, output, experts, routes, input_channels, ids_token_stride);
+    } else {
+        c1_vector_runtime<K, N, NativeIU4, Centered, TILED><<<grid, 32, 0, ctx.stream()>>>(
+            main, rows, tables, activation, ids, output, experts, routes, input_channels, ids_token_stride);
+    }
+}
+
+template<int K, int N, bool NativeIU4, bool Centered>
+static void c1_launch_vector(ggml_backend_cuda_context & ctx, dim3 grid, bool tiled,
+        const uint8_t * main, const half * rows, const half * tables,
+        const C1PackedQ8K32Split * activation, const int32_t * ids, float * output,
+        int experts, int routes, int input_channels, int ids_token_stride) {
+    auto launch = [&](auto layout) {
+        c1_launch_vector_layout<K, N, NativeIU4, Centered, decltype(layout)::value>(
+            ctx, grid, main, rows, tables, activation, ids, output, experts, routes, input_channels, ids_token_stride);
+    };
+    if (tiled) launch(std::true_type{});
+    else launch(std::false_type{});
+}
diff --git a/ggml/src/ggml-cuda/c1-wmma.cuh b/ggml/src/ggml-cuda/c1-wmma.cuh
new file mode 100644
index 0000000000000000000000000000000000000000..7296724a163cccae0b9c0da832b784795180aa43
--- /dev/null
+++ b/ggml/src/ggml-cuda/c1-wmma.cuh
@@ -0,0 +1,547 @@
+// Native C1 BF16 WMMA. The caller supplies HaloBox routing descriptors and BF16 activation storage.
+// K640 C1 rows are 360 bytes, so alternating rows are only 8-byte aligned.
+// Let the compiler lower these 16-byte packet copies without a false uint4
+// alignment promise; the 32-bit table-index load remains naturally aligned.
+__device__ __forceinline__ uint4 mmb_c1_load16(const uint8_t * p) {
+    uint4 v;
+    __builtin_memcpy(&v, p, sizeof(v));
+    return v;
+}
+
+__device__ __forceinline__ uint2 mmb_c1_load8(const uint8_t * p) {
+    uint2 v;
+    __builtin_memcpy(&v, p, sizeof(v));
+    return v;
+}
+
+// C1: one K64 slice of a frozen row is 32 interleaved 4-bit code bytes and four
+// byte indices into the expert's 256-entry FP16 affine table. Row multipliers
+// and table pairs are independent tensors. Only this on-chip BF16 tile expands;
+// the resident weight packet stays at 4.5175 bpw.
+__device__ __forceinline__ void mmb_dq_row_c1(uint4    w0,
+                                              uint4    w1,
+                                              uint32_t indices,
+                                              uint16_t row_scale,
+                                              const uint32_t * __restrict__ table,
+                                              uint32_t * out) {
+    const uint32_t words[8] = { w0.x, w0.y, w0.z, w0.w, w1.x, w1.y, w1.z, w1.w };
+    const float    r        = mmb_h2f(row_scale);
+#pragma unroll
+    for (int g = 0; g < 4; ++g) {
+        const uint32_t pair = table[(indices >> (g * 8)) & 255u];
+        const float    d    = mmb_h2f(uint16_t(pair));
+        const float    m    = mmb_h2f(uint16_t(pair >> 16));
+#pragma unroll
+        for (int w = 0; w < 2; ++w) {
+            const uint32_t q = words[g * 2 + w];
+#pragma unroll
+            for (int b = 0; b < 4; ++b) {
+                const uint8_t packed   = uint8_t(q >> (b * 8));
+                const float   a        = r * fmaf(d, float(packed & 15), m);
+                const float   z        = r * fmaf(d, float(packed >> 4), m);
+                out[g * 8 + w * 4 + b] = mmb_pack2(a, z);
+            }
+        }
+    }
+}
+
+__device__ __forceinline__ void mmb_dq_group_c1(uint2    packed,
+                                                uint8_t  index,
+                                                uint16_t row_scale,
+                                                const uint32_t * __restrict__ table,
+                                                uint32_t * out) {
+    const float    r        = mmb_h2f(row_scale);
+    const uint32_t pair     = table[index];
+    const float    d        = mmb_h2f(uint16_t(pair));
+    const float    m        = mmb_h2f(uint16_t(pair >> 16));
+    const uint32_t words[2] = { packed.x, packed.y };
+#pragma unroll
+    for (int w = 0; w < 2; ++w) {
+        const uint32_t q = words[w];
+#pragma unroll
+        for (int b = 0; b < 4; ++b) {
+            const uint8_t code = uint8_t(q >> (b * 8));
+            const float   a    = r * fmaf(d, float(code & 15), m);
+            const float   z    = r * fmaf(d, float(code >> 4), m);
+            out[w * 4 + b]     = mmb_pack2(a, z);
+        }
+    }
+}
+
+template <typename DRowFn>
+__device__ __forceinline__ void c1_store_tile(const v8f & acc,
+                                              float * __restrict__ stg,
+                                              float * __restrict__ D,
+                                              uint16_t * __restrict__ Dh,
+                                              const bool store_f32,
+                                              const int  M,
+                                              DRowFn     drow,
+                                              const int  n_base,
+                                              const int  m_base,
+                                              const int  lane) {
+    const int cm = lane & 15, cn = lane >> 4;
+#pragma unroll
+    for (int e = 0; e < 8; ++e) {
+        stg[(2 * e + cn) * 16 + cm] = acc[e];
+    }
+    __syncthreads();
+    const int n = lane >> 1, half = lane & 1;
+    const int dr = drow(n_base + n);
+    if (dr >= 0) {
+        const float4 v0   = *(const float4 *) (stg + n * 16 + half * 8),
+                     v1   = *(const float4 *) (stg + n * 16 + half * 8 + 4);
+        const size_t base = (size_t) dr * M + m_base + half * 8;
+        const bool   full = m_base + 16 <= M;
+        if (store_f32) {
+            if (full && (M & 3) == 0) {
+                *(float4 *) (D + base)     = v0;
+                *(float4 *) (D + base + 4) = v1;
+            } else {
+                const float vv[8] = { v0.x, v0.y, v0.z, v0.w, v1.x, v1.y, v1.z, v1.w };
+#pragma unroll
+                for (int k = 0; k < 8; ++k) {
+                    if (m_base + half * 8 + k < M) {
+                        D[base + k] = vv[k];
+                    }
+                }
+            }
+        }
+        if (Dh) {
+            if (full && (M & 7) == 0) {
+                *(uint4 *) (Dh + base) = make_uint4(mmb_pack2(v0.x, v0.y), mmb_pack2(v0.z, v0.w), mmb_pack2(v1.x, v1.y),
+                                                    mmb_pack2(v1.z, v1.w));
+            } else {
+                const float vv[8] = { v0.x, v0.y, v0.z, v0.w, v1.x, v1.y, v1.z, v1.w };
+#pragma unroll
+                for (int k = 0; k < 8; ++k) {
+                    if (m_base + half * 8 + k < M) {
+                        Dh[base + k] = mmb_f2bf(vv[k]);
+                    }
+                }
+            }
+        }
+    }
+    __syncthreads();
+}
+
+template <int BM, int BN, int WTM, int WTN, bool TAIL, bool TILED, typename XRowFn, typename DRowFn>
+__device__ __forceinline__ void c1_tile_gemm(const uint8_t * __restrict__ Wbase,
+                                             const size_t wrow_bytes,
+                                             const int    a_rows,
+                                             const uint16_t * __restrict__ Xh,
+                                             const int K,
+                                             XRowFn    xrow,
+                                             float * __restrict__ D,
+                                             uint16_t * __restrict__ Dh,
+                                             const bool       store_f32,
+                                             const int        M,
+                                             DRowFn           drow,
+                                             const int        m0,
+                                             const int        n_cols,
+                                             uint16_t *       As,
+                                             uint16_t *       Bs,
+                                             const uint16_t * c1_rows  = nullptr,
+                                             const uint32_t * c1_table = nullptr) {
+    constexpr int WAVES_M = BM / WTM, TM = WTM / 16, TN = WTN / 16;
+    constexpr int A_ITEMS = (BM + MMB_NT - 1) / MMB_NT;
+    constexpr int B_ITEMS = (BN * 8) / MMB_NT;
+    const int     tid = threadIdx.x, lane = tid & 31, wave = tid >> 5;
+    const int     wm = wave % WAVES_M, wn = wave / WAVES_M;
+    uint4         a0[A_ITEMS], a1[A_ITEMS];
+    uint32_t      a2[A_ITEMS];
+    uint16_t      c1_scale[A_ITEMS];
+    uint4         bst[B_ITEMS];
+    int           brow[B_ITEMS];
+#pragma unroll
+    for (int i = 0; i < A_ITEMS; ++i) {
+        const int row = tid + i * MMB_NT;
+        c1_scale[i]   = row < BM && row < a_rows ? c1_rows[row] : 0;
+    }
+#pragma unroll
+    for (int i = 0; i < B_ITEMS; ++i) {
+        const int c = tid + i * MMB_NT;
+        brow[i]     = xrow(c >> 3);
+    }
+
+    auto load_regs = [&](const int ks) {
+#pragma unroll
+        for (int i = 0; i < A_ITEMS; ++i) {
+            const int row = tid + i * MMB_NT;
+            if (row < BM && row < a_rows) {
+                const auto offsets = c1_slice<TILED>(row, ks, K, wrow_bytes);
+                a0[i]             = mmb_c1_load16(Wbase + offsets.codes);
+                a1[i]             = mmb_c1_load16(Wbase + offsets.codes + 16);
+                a2[i]             = *(const uint32_t *) (Wbase + offsets.indices);
+            } else {
+                a0[i] = a1[i] = make_uint4(0, 0, 0, 0);
+                a2[i]         = 0;
+            }
+        }
+#pragma unroll
+        for (int i = 0; i < B_ITEMS; ++i) {
+            const int c   = tid + i * MMB_NT;
+            const int off = (c & 7) * 8;
+            bst[i]        = (brow[i] >= 0) ? *(const uint4 *) (Xh + (size_t) brow[i] * K + ks * MMB_BK + off) :
+                                             make_uint4(0, 0, 0, 0);
+        }
+    };
+    auto store_lds = [&]() {
+#pragma unroll
+        for (int i = 0; i < A_ITEMS; ++i) {
+            const int row = tid + i * MMB_NT;
+            if (row < BM) {
+                mmb_dq_row_c1(a0[i], a1[i], a2[i], c1_scale[i], c1_table, (uint32_t *) (As + row * MMB_LDS_STRIDE));
+            }
+        }
+#pragma unroll
+        for (int i = 0; i < B_ITEMS; ++i) {
+            const int c                                               = tid + i * MMB_NT;
+            uint4     v                                               = bst[i];
+            *(uint4 *) (Bs + (c >> 3) * MMB_LDS_STRIDE + (c & 7) * 8) = v;
+        }
+    };
+
+    v8f acc[TM][TN];
+#pragma unroll
+    for (int i = 0; i < TM; ++i)
+#pragma unroll
+        for (int j = 0; j < TN; ++j)
+#pragma unroll
+            for (int e = 0; e < 8; ++e) {
+                acc[i][j][e] = 0.f;
+            }
+
+    bool jact[TN];
+#pragma unroll
+    for (int j = 0; j < TN; ++j) {
+        jact[j] = !TAIL || (wn * WTN + j * 16) < n_cols;  // whole fragments past the valid columns are never stored
+    }
+    const int nks = K / MMB_BK;
+    load_regs(0);
+    store_lds();
+    __syncthreads();
+    for (int ks = 0; ks < nks; ++ks) {
+        if (ks + 1 < nks) {
+            load_regs(ks + 1);
+        }
+#pragma unroll
+        for (int kk = 0; kk < MMB_BK; kk += 16) {
+            v16s      a[TM], b[TN];
+            const int r = lane & 15;
+#pragma unroll
+            for (int i = 0; i < TM; ++i) {
+                const uint16_t * p  = As + (wm * WTM + i * 16 + r) * MMB_LDS_STRIDE + kk;
+                const uint4      v0 = *(const uint4 *) p, v1 = *(const uint4 *) (p + 8);
+                a[i] = __builtin_bit_cast(v16s, (uint4[2]) { v0, v1 });
+            }
+#pragma unroll
+            for (int j = 0; j < TN; ++j) {
+                if constexpr (TAIL) {
+                    if (!jact[j]) {
+                        continue;
+                    }
+                }
+                const uint16_t * p  = Bs + (wn * WTN + j * 16 + r) * MMB_LDS_STRIDE + kk;
+                const uint4      v0 = *(const uint4 *) p, v1 = *(const uint4 *) (p + 8);
+                b[j] = __builtin_bit_cast(v16s, (uint4[2]) { v0, v1 });
+            }
+#pragma unroll
+            for (int i = 0; i < TM; ++i)
+#pragma unroll
+                for (int j = 0; j < TN; ++j) {
+                    if constexpr (TAIL) {
+                        if (!jact[j]) {
+                            continue;
+                        }
+                    }
+                    acc[i][j] = __builtin_amdgcn_wmma_f32_16x16x16_bf16_w32(b[j], a[i], acc[i][j]);
+                }
+        }
+        __syncthreads();
+        if (ks + 1 < nks) {
+            store_lds();
+        }
+        __syncthreads();
+    }
+    // epilogue through LDS (per-wave 1 KB stage in the now-free A/B tile area); tiles are 16 rows, a_rows is a
+    // multiple of 32 in this model, so whole tiles are either valid or beyond a_rows
+    float * stg = (float *) ((BN * MMB_LDS_STRIDE * 2 >= MMB_NT / 32 * 1024) ? Bs : As) + wave * 256;
+#pragma unroll
+    for (int i = 0; i < TM; ++i) {
+        const int  ml = wm * WTM + i * 16;
+        const bool ok = ml < a_rows;
+#pragma unroll
+        for (int j = 0; j < TN; ++j) {
+            if (ok && jact[j]) {
+                c1_store_tile(acc[i][j], stg, D, Dh, store_f32, M, drow, wn * WTN + j * 16, m0 + ml, lane);
+            } else {
+                __syncthreads();
+                __syncthreads();
+            }
+        }
+    }
+}
+
+template <int BM, int BN, int WTM, int WTN, bool TILED>
+__global__ void __launch_bounds__(MMB_NT, 2) mmb_routed_c1_kernel(const uint8_t * __restrict__ W,
+                                                                  const size_t expert_bytes,
+                                                                  const uint16_t * __restrict__ rows,
+                                                                  const uint32_t * __restrict__ tables,
+                                                                  const uint16_t * __restrict__ Xh,
+                                                                  float * __restrict__ D,
+                                                                  uint16_t * __restrict__ Dh,
+                                                                  const bool store_f32,
+                                                                  const int32_t * __restrict__ ids_src,
+                                                                  const int32_t * __restrict__ ids_dst,
+                                                                  const int32_t * __restrict__ bounds,
+                                                                  const uint32_t * __restrict__ desc,
+                                                                  const int M,
+                                                                  const int K) {
+    __shared__ __align__(16) uint16_t As[BM * MMB_LDS_STRIDE];
+    __shared__ __align__(16) uint16_t Bs[BN * MMB_LDS_STRIDE];
+    __shared__ __align__(16) uint32_t table[256];
+    const uint32_t                    dsc = desc[blockIdx.y];
+    if (dsc == UINT32_MAX) {
+        return;
+    }
+    const int e = dsc & 0xffff, jt = dsc >> 16;
+    table[threadIdx.x] = tables[(size_t) e * 256 + threadIdx.x];
+    __syncthreads();
+    const int    r0 = bounds[e] + jt * BN, cnt = bounds[e + 1] - r0;
+    const int    m0         = blockIdx.x * BM;
+    const size_t wrow_bytes = (size_t) K / 2 + (size_t) K / 16;
+    c1_tile_gemm<BM, BN, WTM, WTN, true, TILED>(
+        W + (size_t) e * expert_bytes + (size_t) m0 * wrow_bytes, wrow_bytes, M - m0, Xh, K,
+        [&](int i) { return (i < cnt) ? ids_src[r0 + i] : -1; }, D, Dh, store_f32, M,
+        [&](int i) { return (i < cnt) ? ids_dst[r0 + i] : -1; }, m0, cnt, As, Bs, rows + (size_t) e * M + m0, table);
+}
+
+template <int BM, int BN, int WTM, int WTN, bool TAIL, bool C1_GROUP4, bool TILED, typename XRowFn, typename DRowFn>
+__device__ __forceinline__ void c1_tile_gemm_glu(const uint8_t * __restrict__ Wg,
+                                                 const uint8_t * __restrict__ Wu,
+                                                 const size_t wrow_bytes,
+                                                 const int    a_rows,
+                                                 const uint16_t * __restrict__ Xh,
+                                                 const int K,
+                                                 XRowFn    xrow,
+                                                 float * __restrict__ D,
+                                                 uint16_t * __restrict__ Dh,
+                                                 const bool       store_f32,
+                                                 const int        M,
+                                                 DRowFn           drow,
+                                                 const int        m0,
+                                                 const int        n_cols,
+                                                 uint16_t *       Ag,
+                                                 uint16_t *       Au,
+                                                 uint16_t *       Bs,
+                                                 const uint16_t * c1_grows  = nullptr,
+                                                 const uint16_t * c1_urows  = nullptr,
+                                                 const uint32_t * c1_gtable = nullptr,
+                                                 const uint32_t * c1_utable = nullptr) {
+    constexpr int WAVES_M = BM / WTM, TM = WTM / 16, TN = WTN / 16;
+    constexpr int A_ITEMS = ((C1_GROUP4 ? BM * 4 : BM) + MMB_NT - 1) / MMB_NT;
+    constexpr int B_ITEMS = (BN * 8) / MMB_NT;
+    const int     tid = threadIdx.x, lane = tid & 31, wave = tid >> 5;
+    const int     part = C1_GROUP4 ? tid & 3 : 0;
+    const int     wm = wave % WAVES_M, wn = wave / WAVES_M;
+    uint4         g0[A_ITEMS], g1[A_ITEMS], u0[A_ITEMS], u1[A_ITEMS];
+    uint32_t      g2[A_ITEMS], u2[A_ITEMS], g3[A_ITEMS], u3[A_ITEMS];
+    uint16_t      c1_gscale[A_ITEMS], c1_uscale[A_ITEMS];
+    uint4         bst[B_ITEMS];
+    int           brow[B_ITEMS];
+#pragma unroll
+    for (int i = 0; i < A_ITEMS; ++i) {
+        const int row = C1_GROUP4 ? (tid + i * MMB_NT) / 4 : tid + i * MMB_NT;
+        c1_gscale[i]  = row < BM && row < a_rows ? c1_grows[row] : 0;
+        c1_uscale[i]  = row < BM && row < a_rows ? c1_urows[row] : 0;
+    }
+#pragma unroll
+    for (int i = 0; i < B_ITEMS; ++i) {
+        const int c = tid + i * MMB_NT;
+        brow[i]     = xrow(c >> 3);
+    }
+    auto load_regs = [&](const int ks) {
+#pragma unroll
+        for (int i = 0; i < A_ITEMS; ++i) {
+            const int row = C1_GROUP4 ? (tid + i * MMB_NT) / 4 : tid + i * MMB_NT;
+            if (row < BM && row < a_rows) {
+                const auto offsets = c1_slice<TILED>(row, ks, K, wrow_bytes);
+                if constexpr (C1_GROUP4) {
+                    const uint2 gp = mmb_c1_load8(Wg + offsets.codes + part * 8);
+                    const uint2 up = mmb_c1_load8(Wu + offsets.codes + part * 8);
+                    g0[i]          = make_uint4(gp.x, gp.y, 0, 0);
+                    u0[i]          = make_uint4(up.x, up.y, 0, 0);
+                    g2[i]          = *(Wg + offsets.indices + part);
+                    u2[i]          = *(Wu + offsets.indices + part);
+                } else {
+                    g0[i] = mmb_c1_load16(Wg + offsets.codes);
+                    g1[i] = mmb_c1_load16(Wg + offsets.codes + 16);
+                    u0[i] = mmb_c1_load16(Wu + offsets.codes);
+                    u1[i] = mmb_c1_load16(Wu + offsets.codes + 16);
+                    g2[i] = *(const uint32_t *) (Wg + offsets.indices);
+                    u2[i] = *(const uint32_t *) (Wu + offsets.indices);
+                }
+            } else {
+                g0[i] = g1[i] = u0[i] = u1[i] = make_uint4(0, 0, 0, 0);
+                g2[i] = u2[i] = g3[i] = u3[i] = 0;
+            }
+        }
+#pragma unroll
+        for (int i = 0; i < B_ITEMS; ++i) {
+            const int c   = tid + i * MMB_NT;
+            const int off = (c & 7) * 8;
+            bst[i]        = (brow[i] >= 0) ? *(const uint4 *) (Xh + (size_t) brow[i] * K + ks * MMB_BK + off) :
+                                             make_uint4(0, 0, 0, 0);
+        }
+    };
+    auto store_lds = [&]() {
+#pragma unroll
+        for (int i = 0; i < A_ITEMS; ++i) {
+            const int row = C1_GROUP4 ? (tid + i * MMB_NT) / 4 : tid + i * MMB_NT;
+            if (row < BM) {
+                if constexpr (C1_GROUP4) {
+                    mmb_dq_group_c1(make_uint2(g0[i].x, g0[i].y), (uint8_t) g2[i], c1_gscale[i], c1_gtable,
+                                    (uint32_t *) (Ag + row * MMB_LDS_STRIDE) + part * 8);
+                    mmb_dq_group_c1(make_uint2(u0[i].x, u0[i].y), (uint8_t) u2[i], c1_uscale[i], c1_utable,
+                                    (uint32_t *) (Au + row * MMB_LDS_STRIDE) + part * 8);
+                } else {
+                    mmb_dq_row_c1(g0[i], g1[i], g2[i], c1_gscale[i], c1_gtable,
+                                  (uint32_t *) (Ag + row * MMB_LDS_STRIDE));
+                    mmb_dq_row_c1(u0[i], u1[i], u2[i], c1_uscale[i], c1_utable,
+                                  (uint32_t *) (Au + row * MMB_LDS_STRIDE));
+                }
+            }
+        }
+#pragma unroll
+        for (int i = 0; i < B_ITEMS; ++i) {
+            const int c                                               = tid + i * MMB_NT;
+            uint4     v                                               = bst[i];
+            *(uint4 *) (Bs + (c >> 3) * MMB_LDS_STRIDE + (c & 7) * 8) = v;
+        }
+    };
+    v8f accg[TM][TN], accu[TM][TN];
+#pragma unroll
+    for (int i = 0; i < TM; ++i)
+#pragma unroll
+        for (int j = 0; j < TN; ++j)
+#pragma unroll
+            for (int e = 0; e < 8; ++e) {
+                accg[i][j][e] = 0.f;
+                accu[i][j][e] = 0.f;
+            }
+    bool jact[TN];
+#pragma unroll
+    for (int j = 0; j < TN; ++j) {
+        jact[j] = !TAIL || (wn * WTN + j * 16) < n_cols;
+    }
+    const int nks = K / MMB_BK;
+    load_regs(0);
+    store_lds();
+    __syncthreads();
+    for (int ks = 0; ks < nks; ++ks) {
+        if (ks + 1 < nks) {
+            load_regs(ks + 1);
+        }
+#pragma unroll
+        for (int kk = 0; kk < MMB_BK; kk += 16) {
+            v16s      ag[TM], au[TM], b[TN];
+            const int r = lane & 15;
+#pragma unroll
+            for (int i = 0; i < TM; ++i) {
+                const int off = (wm * WTM + i * 16 + r) * MMB_LDS_STRIDE + kk;
+                ag[i] = __builtin_bit_cast(v16s,
+                                           (uint4[2]) { *(const uint4 *) (Ag + off), *(const uint4 *) (Ag + off + 8) });
+                au[i] = __builtin_bit_cast(v16s,
+                                           (uint4[2]) { *(const uint4 *) (Au + off), *(const uint4 *) (Au + off + 8) });
+            }
+#pragma unroll
+            for (int j = 0; j < TN; ++j) {
+                if constexpr (TAIL) {
+                    if (!jact[j]) {
+                        continue;
+                    }
+                }
+                const uint16_t * p = Bs + (wn * WTN + j * 16 + r) * MMB_LDS_STRIDE + kk;
+                b[j] = __builtin_bit_cast(v16s, (uint4[2]) { *(const uint4 *) p, *(const uint4 *) (p + 8) });
+            }
+#pragma unroll
+            for (int i = 0; i < TM; ++i)
+#pragma unroll
+                for (int j = 0; j < TN; ++j) {
+                    if constexpr (TAIL) {
+                        if (!jact[j]) {
+                            continue;
+                        }
+                    }
+                    accg[i][j] = __builtin_amdgcn_wmma_f32_16x16x16_bf16_w32(b[j], ag[i], accg[i][j]);
+                    accu[i][j] = __builtin_amdgcn_wmma_f32_16x16x16_bf16_w32(b[j], au[i], accu[i][j]);
+                }
+        }
+        __syncthreads();
+        if (ks + 1 < nks) {
+            store_lds();
+        }
+        __syncthreads();
+    }
+    float * stg = (float *) ((BN * MMB_LDS_STRIDE * 2 >= MMB_NT / 32 * 1024) ? Bs : Ag) + wave * 256;
+#pragma unroll
+    for (int i = 0; i < TM; ++i) {
+        const int  ml = wm * WTM + i * 16;
+        const bool ok = ml < a_rows;
+#pragma unroll
+        for (int j = 0; j < TN; ++j) {
+            if (ok && jact[j]) {
+                v8f v;
+#pragma unroll
+                for (int e = 0; e < 8; ++e) {
+                    v[e] = ggml_cuda_op_silu_single(accg[i][j][e]) * (accu[i][j][e]);
+                }
+                c1_store_tile(v, stg, D, Dh, store_f32, M, drow, wn * WTN + j * 16, m0 + ml, lane);
+            } else {
+                __syncthreads();
+                __syncthreads();
+            }
+        }
+    }
+}
+
+template <int BM, int BN, int WTM, int WTN, bool C1_GROUP4, bool TILED>
+__global__ void __launch_bounds__(MMB_NT, 2) mmb_routed_c1_glu_kernel(const uint8_t * __restrict__ Wg,
+                                                                      const uint8_t * __restrict__ Wu,
+                                                                      const size_t expert_bytes,
+                                                                      const uint16_t * __restrict__ grows,
+                                                                      const uint16_t * __restrict__ urows,
+                                                                      const uint32_t * __restrict__ gtables,
+                                                                      const uint32_t * __restrict__ utables,
+                                                                      const uint16_t * __restrict__ Xh,
+                                                                      float * __restrict__ D,
+                                                                      uint16_t * __restrict__ Dh,
+                                                                      const bool store_f32,
+                                                                      const int32_t * __restrict__ ids_src,
+                                                                      const int32_t * __restrict__ ids_dst,
+                                                                      const int32_t * __restrict__ bounds,
+                                                                      const uint32_t * __restrict__ desc,
+                                                                      const int M,
+                                                                      const int K) {
+    __shared__ __align__(16) uint16_t Ag[BM * MMB_LDS_STRIDE];
+    __shared__ __align__(16) uint16_t Au[BM * MMB_LDS_STRIDE];
+    __shared__ __align__(16) uint16_t Bs[BN * MMB_LDS_STRIDE];
+    __shared__ __align__(16) uint32_t gtable[256], utable[256];
+    const uint32_t                    dsc = desc[blockIdx.y];
+    if (dsc == UINT32_MAX) {
+        return;
+    }
+    const int e = dsc & 0xffff, jt = dsc >> 16;
+    gtable[threadIdx.x] = gtables[(size_t) e * 256 + threadIdx.x];
+    utable[threadIdx.x] = utables[(size_t) e * 256 + threadIdx.x];
+    __syncthreads();
+    const int    r0 = bounds[e] + jt * BN, cnt = bounds[e + 1] - r0;
+    const int    m0         = blockIdx.x * BM;
+    const size_t wrow_bytes = (size_t) K / 2 + (size_t) K / 16;
+    c1_tile_gemm_glu<BM, BN, WTM, WTN, true, C1_GROUP4, TILED>(
+        Wg + (size_t) e * expert_bytes + (size_t) m0 * wrow_bytes,
+        Wu + (size_t) e * expert_bytes + (size_t) m0 * wrow_bytes, wrow_bytes, M - m0, Xh, K,
+        [&](int i) { return (i < cnt) ? ids_src[r0 + i] : -1; }, D, Dh, store_f32, M,
+        [&](int i) { return (i < cnt) ? ids_dst[r0 + i] : -1; }, m0, cnt, Ag, Au, Bs, grows + (size_t) e * M + m0,
+        urows + (size_t) e * M + m0, gtable, utable);
+}
diff --git a/ggml/src/ggml-cuda/c1.cu b/ggml/src/ggml-cuda/c1.cu
new file mode 100644
index 0000000000000000000000000000000000000000..74034498c9edf30496cbc71adc25a2adfd6bf1b9
--- /dev/null
+++ b/ggml/src/ggml-cuda/c1.cu
@@ -0,0 +1,357 @@
+#include "c1.cuh"
+
+#include <cstdint>
+#include <cstdlib>
+#include <type_traits>
+
+#if defined(__HIP_PLATFORM_AMD__)
+struct C1PackedQ8K32Split {
+    __fp16 d, s0, s1, pad;
+    uint32_t low[4], high[4];
+};
+static_assert(sizeof(C1PackedQ8K32Split) == 40);
+
+// Same activation producer and integer arithmetic as the isolated frozen
+// C1 graph. Both IU4 and IU8 arms pay this producer and use its exact bytes.
+static __global__ void c1_pack_q8_runtime(const float * source,
+        C1PackedQ8K32Split * output, int groups32, int rows) {
+    const unsigned i = blockIdx.x * blockDim.x + threadIdx.x;
+    if (i >= unsigned(groups32 * rows)) return;
+    const float * x = source + size_t(i) * 32;
+    float vmax = 0, sum0 = 0, sum1 = 0;
+#pragma unroll
+    for (int k = 0; k < 32; ++k) {
+        const float value = x[k];
+        vmax = __builtin_fmaxf(vmax, __builtin_fabsf(value));
+        if (k < 16) sum0 += value;
+        else sum1 += value;
+    }
+    const float d = vmax / 127.0f;
+    C1PackedQ8K32Split result = {};
+    result.d = __fp16(d);
+    result.s0 = __fp16(sum0);
+    result.s1 = __fp16(sum1);
+#pragma unroll
+    for (int k = 0; k < 32; ++k) {
+        const int q = vmax == 0 ? 0 : int(__builtin_roundf(x[k] / d));
+        const uint32_t shift = 4 * (k & 7);
+        result.low[k >> 3] |= (uint32_t(q) & 15u) << shift;
+        result.high[k >> 3] |= ((uint32_t(q) >> 4) & 15u) << shift;
+    }
+    output[i] = result;
+}
+
+static __device__ __forceinline__ uint32_t c1_load32(const void * source) {
+    uint32_t value;
+    __builtin_memcpy(&value, source, sizeof(value));
+    return value;
+}
+static __device__ __forceinline__ uint32_t c1_unpack4(uint32_t value) {
+    return (value & 0x000fu) | ((value & 0x00f0u) << 4) |
+           ((value & 0x0f00u) << 8) | ((value & 0xf000u) << 12);
+}
+static __device__ __forceinline__ uint32_t c1_unpack_centered4(uint32_t value) {
+    // Flip the nibble sign bit, then sign-extend each nibble independently.
+    // The returned four bytes are exactly int8_t(code - 8), without a carry
+    // between bytes as a packed subtraction would introduce.
+    uint32_t bytes = c1_unpack4(value ^ 0x8888u);
+    const uint32_t sign = bytes & 0x08080808u;
+    bytes |= (sign << 1) | (sign << 2) | (sign << 3) | (sign << 4);
+    return bytes;
+}
+static __device__ __forceinline__ uint32_t c1_restore_q8(uint32_t low, uint32_t high) {
+    return c1_unpack4(low) | (c1_unpack4(high) << 4);
+}
+
+template<int K, int N, bool NativeIU4, bool Centered, bool TILED>
+static __global__ __launch_bounds__(32) void c1_vector_runtime(
+        const uint8_t * __restrict__ main, const half * __restrict__ rows,
+        const half * __restrict__ tables, const C1PackedQ8K32Split * __restrict__ activation,
+        const int32_t * __restrict__ ids, float * __restrict__ output,
+        int experts, int routes, int input_channels, int ids_token_stride) {
+    constexpr int Groups16 = K / 16;
+    constexpr int Groups32 = K / 32;
+    constexpr int MainRowBytes = K / 2 + K / 16;
+    constexpr int MainExpertBytes = N * MainRowBytes;
+    const unsigned lane = threadIdx.x;
+    const unsigned n = blockIdx.x;
+    const unsigned route = blockIdx.y;
+    const unsigned token = blockIdx.z;
+    const int expert = ids[size_t(token) * ids_token_stride + route];
+    if (expert < 0 || expert >= experts) return;
+    const uint8_t * expert_main = main + size_t(expert) * MainExpertBytes;
+    const C1PackedQ8K32Split * x = activation +
+        (size_t(token) * input_channels + route % input_channels) * Groups32;
+    const float r = float(rows[size_t(expert) * N + n]);
+    const half * table = tables + size_t(expert) * 512;
+    float total = 0.0f;
+#pragma clang loop unroll(disable)
+    for (unsigned g = lane; g < Groups16; g += 32) {
+        const unsigned half_group = g & 1, full_group = g >> 1;
+        const auto offsets = c1_k16<TILED>(n, g, K);
+        const uint8_t * code_ptr = expert_main + offsets.codes;
+        const C1PackedQ8K32Split & a = x[full_group];
+        int dot = 0;
+#pragma unroll
+        for (int j = 0; j < 2; ++j) {
+            const uint32_t code = c1_load32(code_ptr + j * 4);
+            const uint32_t low = a.low[half_group * 2 + j];
+            const uint32_t high = a.high[half_group * 2 + j];
+            if constexpr (NativeIU4) {
+                const uint32_t w = Centered ? code ^ 0x88888888u : code;
+                dot = __builtin_amdgcn_sudot8(Centered, int(w), false, int(low), dot, false);
+                const int hi = __builtin_amdgcn_sudot8(Centered, int(w), true, int(high), 0, false);
+                dot += 16 * hi;
+            } else {
+                const uint32_t w0 = Centered ? c1_unpack_centered4(code & 0xffffu) : c1_unpack4(code & 0xffffu);
+                const uint32_t w1 = Centered ? c1_unpack_centered4(code >> 16) : c1_unpack4(code >> 16);
+                const uint32_t x0 = c1_restore_q8(low & 0xffffu, high & 0xffffu);
+                const uint32_t x1 = c1_restore_q8(low >> 16, high >> 16);
+                dot = __builtin_amdgcn_sudot4(Centered, int(w0), true, int(x0), dot, false);
+                dot = __builtin_amdgcn_sudot4(Centered, int(w1), true, int(x1), dot, false);
+            }
+        }
+        const uint8_t index = expert_main[offsets.indices];
+        const float table_d = float(table[2 * unsigned(index)]);
+        const float table_m = float(table[2 * unsigned(index) + 1]);
+        const float d = r * table_d;
+        const float m = r * (table_m + (Centered ? 8.0f * table_d : 0.0f));
+        const float sx = float(half_group ? a.s1 : a.s0);
+        total += d * float(a.d) * float(dot) + m * sx;
+    }
+#pragma unroll
+    for (unsigned offset = 16; offset > 0; offset >>= 1) {
+        const uint32_t bits = __builtin_bit_cast(uint32_t, total);
+        const uint32_t peer = __builtin_amdgcn_ds_bpermute((lane ^ offset) * 4, bits);
+        total += __builtin_bit_cast(float, peer);
+    }
+    if (lane == 0) output[(size_t(token) * routes + route) * N + n] = total;
+}
+
+#include "c1-vector-r4.cuh"
+
+static bool c1_use_same_value_iu8() {
+    static const bool use_iu8 = [] {
+        const char * value = std::getenv("LLAMA_C1_IU8");
+        return value && value[0] == '1';
+    }();
+    return use_iu8;
+}
+
+static bool c1_use_centered_activation() {
+    static const bool centered = [] {
+        const char * value = std::getenv("LLAMA_C1_CENTERED");
+        const bool enabled = value && value[0] == '1';
+        if (enabled) std::fprintf(stderr, "C1 centered activation enabled (LLAMA_C1_CENTERED=1)\n");
+        return enabled;
+    }();
+    return centered;
+}
+#endif
+
+#include "c1-grouped.cuh"
+
+// A deliberately simple F32 reference backend for integration/quality checks.
+// The GGUF main tensor contains codes and indices adjacent per output row;
+// row multipliers and affine tables are two independent FP16 source tensors.
+// It is not the native IU4 execution path and cannot establish speed.
+template <bool TILED>
+static __global__ void c1_mat_id_reference(
+        const uint8_t * __restrict__ main,
+        const half * __restrict__ rows,
+        const half * __restrict__ tables,
+        const float * __restrict__ input,
+        const int32_t * __restrict__ ids,
+        float * __restrict__ output,
+        int k, int n, int experts, int routes, int tokens, int input_channels,
+        size_t main_expert_stride, size_t rows_expert_stride, size_t table_expert_stride,
+        size_t input_route_stride, size_t input_token_stride,
+        size_t ids_token_stride, size_t output_route_stride, size_t output_token_stride) {
+    const int row = blockIdx.x * blockDim.x + threadIdx.x;
+    const int route = blockIdx.y;
+    const int token = blockIdx.z;
+    if (row >= n || route >= routes || token >= tokens) return;
+
+    const int expert = *reinterpret_cast<const int32_t *>(
+        reinterpret_cast<const uint8_t *>(ids) + token * ids_token_stride + route * sizeof(int32_t));
+    if (expert < 0 || expert >= experts) return;
+    const uint8_t * expert_main = main + expert * main_expert_stride;
+    const half * table = reinterpret_cast<const half *>(
+        reinterpret_cast<const uint8_t *>(tables) + expert * table_expert_stride);
+    const float * x = reinterpret_cast<const float *>(
+        reinterpret_cast<const uint8_t *>(input) + token * input_token_stride
+            + (route % input_channels) * input_route_stride);
+    const float r = __half2float(*reinterpret_cast<const half *>(
+        reinterpret_cast<const uint8_t *>(rows) + expert * rows_expert_stride + row * sizeof(half)));
+    float sum = 0.0f;
+    for (int group = 0; group < k / 16; ++group) {
+        const auto offsets = c1_k16<TILED>(row, group, k);
+        const int idx = expert_main[offsets.indices];
+        const float d = __half2float(table[2 * idx]);
+        const float m = __half2float(table[2 * idx + 1]);
+        const int base = group * 16;
+        for (int j = 0; j < 8; ++j) {
+            const uint8_t both = expert_main[offsets.codes + j];
+            sum += x[base + 2 * j] * (r * (d * float(both & 15) + m));
+            sum += x[base + 2 * j + 1] * (r * (d * float(both >> 4) + m));
+        }
+    }
+    *reinterpret_cast<float *>(reinterpret_cast<uint8_t *>(output)
+            + token * output_token_stride + route * output_route_stride + row * sizeof(float)) = sum;
+}
+
+#if defined(__HIP_PLATFORM_AMD__)
+// Reuse R4 for small joint batches while preserving layout guards.
+static bool c1_small_batch_vector_eligible(const ggml_tensor * dst) {
+    if (dst->ne[2] <= 8 || dst->ne[2] > 16 ||
+            !(c1_use_vector_r4() || c1_use_vector_r4_lut())) return false;
+    const ggml_tensor * w = dst->src[0], * x = dst->src[1], * ids = dst->src[2];
+    const ggml_tensor * rows = dst->src[3], * tables = dst->src[4];
+    const int64_t k = w->ne[0], n = w->ne[1], routes = dst->ne[1];
+    return w->ne[2] == 512 && routes > 0 &&
+        (x->ne[1] == 1 || x->ne[1] == routes) &&
+        ((k == 2560 && n == 640) || (k == 640 && n == 2560)) &&
+        ggml_is_contiguous(w) && ggml_is_contiguous(x) &&
+        ids->nb[0] == sizeof(int32_t) && ids->nb[1] % sizeof(int32_t) == 0 &&
+        ggml_is_contiguous(dst) && ggml_is_contiguous(rows) && ggml_is_contiguous(tables) &&
+        !(reinterpret_cast<uintptr_t>(w->data) & 1u) && !(w->nb[1] & 1u) && !(w->nb[2] & 1u);
+}
+
+#endif
+
+void ggml_cuda_mul_mat_id_c1(ggml_backend_cuda_context & ctx, ggml_tensor * dst) {
+    const ggml_tensor * w = dst->src[0];
+    const ggml_tensor * x = dst->src[1];
+    const ggml_tensor * ids = dst->src[2];
+    const ggml_tensor * rows = dst->src[3];
+    const ggml_tensor * tables = dst->src[4];
+    GGML_ASSERT(w && x && ids && rows && tables);
+    GGML_ASSERT(w->type == GGML_TYPE_C1_G16_K2560 || w->type == GGML_TYPE_C1_G16_K640);
+    GGML_ASSERT(x->type == GGML_TYPE_F32 && ids->type == GGML_TYPE_I32 && dst->type == GGML_TYPE_F32);
+    GGML_ASSERT(rows->type == GGML_TYPE_F16 && tables->type == GGML_TYPE_F16);
+    GGML_ASSERT(w->ne[0] == (w->type == GGML_TYPE_C1_G16_K2560 ? 2560 : 640));
+    GGML_ASSERT(rows->ne[0] == w->ne[1] && rows->ne[1] == w->ne[2]);
+    GGML_ASSERT(tables->ne[0] == 2 && tables->ne[1] == 256 && tables->ne[2] == w->ne[2]);
+    GGML_ASSERT(x->ne[0] == w->ne[0] && ids->ne[0] == dst->ne[1] && ids->ne[1] == dst->ne[2]);
+    GGML_ASSERT(dst->ne[0] == w->ne[1]);
+    GGML_ASSERT(w->nb[1] == size_t(w->ne[0] / 2 + w->ne[0] / 16));
+    GGML_ASSERT(x->nb[0] == sizeof(float) && ids->nb[0] == sizeof(int32_t) && dst->nb[0] == sizeof(float));
+
+    static int dispatch_hits = 0;
+    if (std::getenv("LLAMA_C1_TRACE") && dispatch_hits++ < 12) {
+        std::fprintf(stderr,
+            "C1 dispatch %s centered=%d K=%lld N=%lld experts=%lld routes=%lld tokens=%lld x_channels=%lld "
+            "contig(w,x,ids,dst,rows,tables)=%d,%d,%d,%d,%d,%d x_strides=%zu,%zu,%zu ids_strides=%zu,%zu\n",
+            c1_use_same_value_iu8() ? "IU8" : "IU4", int(c1_use_centered_activation()),
+            (long long) w->ne[0], (long long) w->ne[1], (long long) w->ne[2],
+            (long long) dst->ne[1], (long long) dst->ne[2], (long long) x->ne[1],
+            int(ggml_is_contiguous(w)), int(ggml_is_contiguous(x)), int(ggml_is_contiguous(ids)),
+            int(ggml_is_contiguous(dst)), int(ggml_is_contiguous(rows)), int(ggml_is_contiguous(tables)),
+            x->nb[0], x->nb[1], x->nb[2], ids->nb[0], ids->nb[1]);
+    }
+
+#if defined(__HIP_PLATFORM_AMD__)
+    const bool small_batch_vector = c1_small_batch_vector_eligible(dst);
+    if (!small_batch_vector && c1_grouped::run(ctx, dst, c1_use_same_value_iu8(), c1_use_centered_activation())) {
+        static int grouped_hits = 0;
+        if (std::getenv("LLAMA_C1_TRACE") && grouped_hits++ < 12) {
+            std::fprintf(stderr, "C1 grouped %s centered=%d K=%lld N=%lld experts=%lld routes=%lld tokens=%lld x_channels=%lld\n",
+                c1_use_same_value_iu8() ? "IU8" : "IU4", int(c1_use_centered_activation()),
+                (long long) w->ne[0], (long long) w->ne[1], (long long) w->ne[2],
+                (long long) dst->ne[1], (long long) dst->ne[2], (long long) x->ne[1]);
+        }
+        return;
+    }
+#endif
+
+#if defined(__HIP_PLATFORM_AMD__)
+    if ((dst->ne[2] <= 8 || small_batch_vector) && ggml_is_contiguous(x) && ids->nb[0] == sizeof(int32_t) &&
+            ids->nb[1] % sizeof(int32_t) == 0 && ggml_is_contiguous(dst) &&
+            ggml_is_contiguous(rows) && ggml_is_contiguous(tables)) {
+        static int vector_hits = 0;
+        if (std::getenv("LLAMA_C1_TRACE") && vector_hits++ < 12) {
+            std::fprintf(stderr, "C1 vector %s centered=%d K=%lld N=%lld experts=%lld routes=%lld tokens=%lld x_channels=%lld\n",
+                c1_use_same_value_iu8() ? "IU8" : "IU4", int(c1_use_centered_activation()),
+                (long long) w->ne[0], (long long) w->ne[1], (long long) w->ne[2],
+                (long long) dst->ne[1], (long long) dst->ne[2], (long long) x->ne[1]);
+        }
+        const bool tiled = ggml_cuda_c1_tiled(w);
+        const int k = int(w->ne[0]);
+        const int n = int(w->ne[1]);
+        const int groups32 = k / 32;
+        const int activation_rows = int(x->ne[1] * x->ne[2]);
+        ggml_cuda_pool_alloc<C1PackedQ8K32Split> packed(ctx.pool(), size_t(groups32) * activation_rows);
+        const int blocks = (groups32 * activation_rows + 255) / 256;
+        c1_pack_q8_runtime<<<blocks, 256, 0, ctx.stream()>>>(
+            static_cast<const float *>(x->data), packed.ptr, groups32, activation_rows);
+        const dim3 vector_grid(unsigned(n), unsigned(dst->ne[1]), unsigned(dst->ne[2]));
+        const auto * main = static_cast<const uint8_t *>(w->data);
+        const auto * row_scales = static_cast<const half *>(rows->data);
+        const auto * table = static_cast<const half *>(tables->data);
+        const auto * selected = static_cast<const int32_t *>(ids->data);
+        auto * output = static_cast<float *>(dst->data);
+        const int ids_token_stride = int(ids->nb[1] / sizeof(int32_t));
+        if (k == 2560 && n == 640) {
+            if (c1_use_same_value_iu8()) {
+                if (c1_use_centered_activation()) {
+                    c1_launch_vector<2560, 640, false, true>(ctx, vector_grid, tiled,
+                        main, row_scales, table, packed.ptr, selected, output, int(w->ne[2]), int(dst->ne[1]), int(x->ne[1]), ids_token_stride);
+                } else {
+                    c1_launch_vector<2560, 640, false, false>(ctx, vector_grid, tiled,
+                        main, row_scales, table, packed.ptr, selected, output, int(w->ne[2]), int(dst->ne[1]), int(x->ne[1]), ids_token_stride);
+                }
+            } else {
+                if (c1_use_centered_activation()) {
+                    c1_launch_vector<2560, 640, true, true>(ctx, vector_grid, tiled,
+                        main, row_scales, table, packed.ptr, selected, output, int(w->ne[2]), int(dst->ne[1]), int(x->ne[1]), ids_token_stride);
+                } else {
+                    c1_launch_vector<2560, 640, true, false>(ctx, vector_grid, tiled,
+                        main, row_scales, table, packed.ptr, selected, output, int(w->ne[2]), int(dst->ne[1]), int(x->ne[1]), ids_token_stride);
+                }
+            }
+        } else if (k == 640 && n == 2560) {
+            if (c1_use_same_value_iu8()) {
+                if (c1_use_centered_activation()) {
+                    c1_launch_vector<640, 2560, false, true>(ctx, vector_grid, tiled,
+                        main, row_scales, table, packed.ptr, selected, output, int(w->ne[2]), int(dst->ne[1]), int(x->ne[1]), ids_token_stride);
+                } else {
+                    c1_launch_vector<640, 2560, false, false>(ctx, vector_grid, tiled,
+                        main, row_scales, table, packed.ptr, selected, output, int(w->ne[2]), int(dst->ne[1]), int(x->ne[1]), ids_token_stride);
+                }
+            } else {
+                if (c1_use_centered_activation()) {
+                    c1_launch_vector<640, 2560, true, true>(ctx, vector_grid, tiled,
+                        main, row_scales, table, packed.ptr, selected, output, int(w->ne[2]), int(dst->ne[1]), int(x->ne[1]), ids_token_stride);
+                } else {
+                    c1_launch_vector<640, 2560, true, false>(ctx, vector_grid, tiled,
+                        main, row_scales, table, packed.ptr, selected, output, int(w->ne[2]), int(dst->ne[1]), int(x->ne[1]), ids_token_stride);
+                }
+            }
+        } else {
+            GGML_ABORT("unsupported C1 projection geometry");
+        }
+        CUDA_CHECK(cudaGetLastError());
+        return;
+    }
+#endif
+
+    static int reference_hits = 0;
+    if (std::getenv("LLAMA_C1_TRACE") && reference_hits++ < 12) {
+        std::fprintf(stderr, "C1 F32 reference K=%lld N=%lld experts=%lld routes=%lld tokens=%lld x_channels=%lld\n",
+            (long long) w->ne[0], (long long) w->ne[1], (long long) w->ne[2],
+            (long long) dst->ne[1], (long long) dst->ne[2], (long long) x->ne[1]);
+    }
+    const dim3 grid((unsigned(w->ne[1]) + 127) / 128, unsigned(dst->ne[1]), unsigned(dst->ne[2]));
+    auto launch_reference = [&](auto layout) {
+        c1_mat_id_reference<decltype(layout)::value><<<grid, 128, 0, ctx.stream()>>>(
+            static_cast<const uint8_t *>(w->data), static_cast<const half *>(rows->data),
+            static_cast<const half *>(tables->data), static_cast<const float *>(x->data),
+            static_cast<const int32_t *>(ids->data), static_cast<float *>(dst->data),
+            int(w->ne[0]), int(w->ne[1]), int(w->ne[2]), int(dst->ne[1]), int(dst->ne[2]), int(x->ne[1]),
+            w->nb[2], rows->nb[1], tables->nb[2], x->ne[1] > 1 ? x->nb[1] : 0,
+            x->nb[2], ids->nb[1], dst->nb[1], dst->nb[2]);
+    };
+    if (ggml_cuda_c1_tiled(w)) launch_reference(std::true_type{});
+    else launch_reference(std::false_type{});
+    CUDA_CHECK(cudaGetLastError());
+}
diff --git a/ggml/src/ggml-cuda/c1.cuh b/ggml/src/ggml-cuda/c1.cuh
new file mode 100644
index 0000000000000000000000000000000000000000..1c27252b9d6034ee2431126c19e321096dac6db3
--- /dev/null
+++ b/ggml/src/ggml-cuda/c1.cuh
@@ -0,0 +1,41 @@
+#pragma once
+
+#include "common.cuh"
+
+static inline bool ggml_cuda_is_c1(ggml_type type) {
+    return type == GGML_TYPE_C1_G16_K2560 || type == GGML_TYPE_C1_G16_K640;
+}
+
+// Experimental C1 dispatch: native/same-value vector paths for short batches,
+// grouped WMMA for contiguous larger batches, and F32 reference fallback.
+// Source compilation alone is not a full-model performance result.
+void ggml_cuda_mul_mat_id_c1(ggml_backend_cuda_context & ctx, ggml_tensor * dst);
+
+// Loader invokes this only on private device weight allocations before publishing the model.
+bool ggml_cuda_c1_pack_loaded(ggml_tensor * w);
+bool ggml_cuda_c1_tiled(const ggml_tensor * w);
+bool ggml_cuda_c1_has_tiled();
+// A complete 16-row x K64 tile holds 512 bytes of codes and 64 bytes of
+// indices. The caller's block offset is a multiple of 16 whole output rows.
+struct c1_slice_offsets {
+    size_t codes;
+    size_t indices;
+};
+
+template <bool TILED>
+__device__ __forceinline__ c1_slice_offsets c1_slice(const int row, const int ks, const int K, const size_t row_bytes) {
+    if constexpr (TILED) {
+        const size_t tile = (size_t(row / 16) * (K / 64) + ks) * 576;
+        return {tile + (row % 16) * 32, tile + 512 + (row % 16) * 4};
+    } else {
+        const size_t start = size_t(row) * row_bytes;
+        return {start + ks * 32, start + K / 2 + ks * 4};
+    }
+}
+
+
+template <bool TILED>
+__device__ __forceinline__ c1_slice_offsets c1_k16(const int row, const int group, const int k) {
+    const auto slice = c1_slice<TILED>(row, group / 4, k, size_t(k / 2 + k / 16));
+    return {slice.codes + (group % 4) * 8, slice.indices + group % 4};
+}
diff --git a/ggml/src/ggml-cuda/component-control.cuh b/ggml/src/ggml-cuda/component-control.cuh
new file mode 100644
index 0000000000000000000000000000000000000000..5be0c8da59d8036c4b9c35a5309c90ae5aa9c2ac
--- /dev/null
+++ b/ggml/src/ggml-cuda/component-control.cuh
@@ -0,0 +1,8 @@
+// Component control launches the unchanged native SGMA producer on the caller's stream.
+#include "merge-hc-abi.h"
+
+void ggml_cuda_hc_component_control_merge(const merge_hc_args & a, cudaStream_t stream) {
+    moe_weighted_reduction_sgma_v4<true><<<4092, 640, 0, stream>>>(
+        a.experts, a.expert_scale, a.route_weights, a.shared_gate, a.shared_out,
+        a.merged, 2560, 10);
+}
diff --git a/ggml/src/ggml-cuda/component-launch.cuh b/ggml/src/ggml-cuda/component-launch.cuh
new file mode 100644
index 0000000000000000000000000000000000000000..c627dff865051482f554a16428c01c57be498883
--- /dev/null
+++ b/ggml/src/ggml-cuda/component-launch.cuh
@@ -0,0 +1,37 @@
+#include "merge-hc-abi.h"
+
+void ggml_cuda_hc_component_control_merge(const merge_hc_args & a, cudaStream_t stream);
+
+extern "C" __attribute__((visibility("default")))
+int ciru_merge_hc_run(const merge_hc_args * args, int mode, void * user_stream) {
+    if (args == nullptr || mode < 0 || mode > 2) {
+        return hipErrorInvalidValue;
+    }
+    const auto & a = *args;
+    if (!a.experts || !a.route_weights || !a.shared_gate || !a.shared_out || !a.inject ||
+            !a.res_in || !a.gamma || !a.w_inject || !a.out_inj ||
+            (mode != 1 && !a.merged) || bool(a.out_res32) == bool(a.out_res16) ||
+            bool(a.out_q8) != bool(a.out_q8s)) {
+        return hipErrorInvalidValue;
+    }
+    auto stream = reinterpret_cast<cudaStream_t>(user_stream);
+    const dim3 grid(4092, 1, 1);
+    const ggml_cuda_hc_routed_merge merge{a.experts, a.expert_scale, a.route_weights, a.shared_gate, a.shared_out, 10};
+#define HC_TEST_ARGS a.inject, a.res_in, a.merged, a.gamma, \
+    a.out_res32, a.out_res16, a.out_xn32, a.out_xn16, 2560, a.s1, a.b1, a.s2, a.b2, a.eps, \
+    a.w_inject, a.out_inj, a.out_q8, a.out_q8s, 80
+    if (mode == 0) {
+        ggml_cuda_hc_component_control_merge(a, stream);
+        const hipError_t status = hipGetLastError();
+        if (status != hipSuccess) {
+            return status;
+        }
+        hc_combine_norm_inject_v2<true, false><<<grid, 320, 0, stream>>>(HC_TEST_ARGS);
+    } else if (mode == 1) {
+        hc_combine_norm_inject_v2<true, false, true, false><<<grid, 320, 0, stream>>>(HC_TEST_ARGS, merge, nullptr);
+    } else {
+        hc_combine_norm_inject_v2<true, false, true, true><<<grid, 320, 0, stream>>>(HC_TEST_ARGS, merge, a.merged);
+    }
+#undef HC_TEST_ARGS
+    return hipGetLastError();
+}
