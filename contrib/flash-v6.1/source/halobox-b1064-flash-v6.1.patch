--- /dev/null
+++ b/src/verifier-top20.h
@@ -0,0 +1,19 @@
+#pragma once
+#include <cstdint>
+#include <cstring>
+struct verifier_candidate { int32_t id; float logit; };
+static_assert(sizeof(verifier_candidate)==8, "device packet layout");
+
+static inline bool verifier_top20_row(const verifier_candidate *row, int32_t *ids, float *values) {
+    for (int i=0; i<21; ++i) {
+        uint32_t bits;
+        std::memcpy(&bits,&row[i].logit,sizeof(bits));
+        if (row[i].id < 0 || row[i].id >= 248320 || (bits & 0x7f800000u)==0x7f800000u ||
+                (i && !(row[i-1].logit > row[i].logit))) return false;
+    }
+    for (int i=0; i<20; ++i) {
+        ids[i]=row[i].id;
+        values[i]=row[i].logit;
+    }
+    return true;
+}
