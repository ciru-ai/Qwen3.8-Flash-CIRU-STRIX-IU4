+// C1 static grid begins. Buy the cheapest per-expert descriptor increments:
+// threshold rows for the first, width+1-threshold more for the second,
+// and width more for each remaining descriptor. Invalid routes cost no tickets.
+template<int width, int threshold>
+static int mmb_c1_wide_capacity(int rows, int experts) {
+    constexpr int second_cost = width+1-threshold;
+    static_assert(threshold > 0 && threshold <= second_cost && second_cost <= width);
+    const int first = std::min(experts, rows/threshold);
+    rows -= first*threshold;
+    const int second = std::min(first, rows/second_cost);
+    rows -= second*second_cost;
+    return std::max(1, first+second+rows/width);
+}
