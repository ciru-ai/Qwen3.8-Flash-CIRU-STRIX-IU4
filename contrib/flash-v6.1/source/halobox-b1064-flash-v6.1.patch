+// Each wave owns a whole 128-column head, keeping the four Conv/SiLU results
+// per lane in registers until its RMS reduction. The V heads simply store SiLU.
+static __global__ __launch_bounds__(256) void gdn_conv_qk_rms_exact(
+        const float * __restrict__ state, const float * __restrict__ x, const float * __restrict__ w,
+        float * __restrict__ out, int T, float eps, float scale_out) {
+    constexpr int C = 10240, tt = 16;
+    const int lane = threadIdx.x, head = blockIdx.x * 8 + threadIdx.y;
+    const int t0 = blockIdx.y * tt;
+    float taps[4][4], history[4][4];
+#pragma unroll
+    for (int p = 0; p < 4; ++p) {
+        const int c = head * 128 + p * 32 + lane;
+#pragma unroll
+        for (int j = 0; j < 4; ++j) {
+            taps[p][j] = w[c * 4 + j];
+            const int t = t0 + j - 3;
+            history[p][j] = t < 0 ? state[c * 3 + (t + 3)] : x[(size_t)t * C + c];
+        }
+    }
+    for (int t = t0; t < min(T, t0 + tt); ++t) {
+        float value[4], part[4];
+#pragma unroll
+        for (int p = 0; p < 4; ++p) {
