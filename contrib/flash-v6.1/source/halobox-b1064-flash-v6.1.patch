+                // multiply as a HIP ISA instruction prevents LLVM contracting that add.
+                float square;
+                asm("v_mul_f32 %0, %1, %1" : "=v"(square) : "v"(value[p]));
+                part[p] = warp_reduce_sum<32>(square);
+            }
+        }
+        float scale = 1.0f;
+        if (head < 32) {
+            // The stock 256-thread RMS block first reduces each 32-column group.
+            // Its second xor tree uses lane 0 from each group and four zero waves.
+            const float ss = ggml_cuda_shfl((part[0] + part[2]) + (part[1] + part[3]), 0, 32);
