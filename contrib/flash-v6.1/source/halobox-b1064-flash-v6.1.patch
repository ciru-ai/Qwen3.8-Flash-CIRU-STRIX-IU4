diff --git a/scripts/ciru/flash-v6/gdn-norm.hip b/scripts/ciru/flash-v6/gdn-norm.hip
new file mode 100644
index 0000000000000000000000000000000000000000..036b06e7a95a0fd78344d1e6fe88a764c3c9c2f4
--- /dev/null
+++ b/scripts/ciru/flash-v6/gdn-norm.hip
@@ -0,0 +1,232 @@
+// Prepared, compensated 16-token GDN scan for gfx1151. WMMA order and all
+// high/residual BF16 rounding boundaries follow ggml's gdn_single<16,64,1,true>.
+#include <hip/hip_runtime.h>
+#include <cstdint>
+#include <cstddef>
+#include <cstring>
+
+namespace {
+struct Gdn {
+    const float *q, *k, *v, *g, *beta, *state;
+    float *dst, *state_out;
+    int64_t H,H_k,n_tokens,n_seqs,rq3,sq1,sq2,sq3,sv1,sv2,sv3,sb1,sb2,sb3;
+    float scale;
+    bool eligible;
+};
+struct alignas(16) Prepared {
+    uint16_t p_hi[256], p_lo[256], inv_hi[256], inv_lo[256];
+    float prefix[16], beta[16];
+};
+static_assert(sizeof(Gdn) == 184 && alignof(Gdn) == 8);
+static_assert(offsetof(Gdn, state_out) == 56 && offsetof(Gdn, H) == 64);
+static_assert(offsetof(Gdn, scale) == 176 && offsetof(Gdn, eligible) == 180);
+static_assert(sizeof(Prepared) == 2176 && alignof(Prepared) == 16);
+static_assert(offsetof(Prepared, prefix) == 2048 && offsetof(Prepared, beta) == 2112);
+using Acc = float __attribute__((ext_vector_type(8)));
+using Bits = short __attribute__((ext_vector_type(16)));
+using Words = unsigned __attribute__((ext_vector_type(8)));
+struct Operand { Words hi, lo; };
+constexpr int W=8, D=128, C=16;
+struct Norm {
+    const float *weight, *gate;
+    float *out;
+    uint16_t *out16;
+    float eps;
+    bool fp16;
+};
+__device__ __forceinline__ float xor_sum(float x) {
+#pragma unroll
+    for(int offset=16;offset>0;offset>>=1) x+=__shfl_xor(x,offset,32);
+    return x;
+}
+__device__ __forceinline__ uint16_t pack_norm(float x,bool fp16) {
+    if(fp16) {
+        const float bounded=x>65504.0f?65504.0f:(x< -65504.0f?-65504.0f:x);
+        return __builtin_bit_cast(uint16_t,static_cast<_Float16>(bounded));
+    }
+    uint32_t u=__builtin_bit_cast(uint32_t,x);
+    u+=0x7fffU+((u>>16)&1U);
+    return uint16_t(u>>16);
+}
+
+__device__ __forceinline__ unsigned split(float x) {
+    const __bf16 h=static_cast<__bf16>(x);
+    const __bf16 l=static_cast<__bf16>(x-static_cast<float>(h));
+    return unsigned(__builtin_bit_cast(uint16_t,h)) | unsigned(__builtin_bit_cast(uint16_t,l))<<16;
+}
+// Stock store_qk uses a separately rounded high half, while its low term
+// is emitted as a fused multiply-subtract of the original unscaled Q.
+__device__ __forceinline__ unsigned split_scaled_q(float raw,float scale) {
+    const __bf16 h=static_cast<__bf16>(raw*scale);
+    const __bf16 l=static_cast<__bf16>(fmaf(raw,scale,-static_cast<float>(h)));
+    return unsigned(__builtin_bit_cast(uint16_t,h)) | unsigned(__builtin_bit_cast(uint16_t,l))<<16;
+}
+__device__ __forceinline__ float join(unsigned p) {
+    return __uint_as_float(p<<16) + __uint_as_float(p&0xffff0000u);
+}
+// Pack two high halves or two residual halves directly into one VGPR.
+__device__ __forceinline__ void set_pair(Operand &a,int i,unsigned left,unsigned right) {
+    a.hi[i]=__builtin_amdgcn_perm(right,left,0x05040100u);
+    a.lo[i]=__builtin_amdgcn_perm(right,left,0x07060302u);
+}
+__device__ __forceinline__ void product(Acc &c,const Operand &a,const Operand &b) {
+#if defined(__gfx1151__)
+    c=__builtin_amdgcn_wmma_f32_16x16x16_bf16_w32(__builtin_bit_cast(Bits,a.lo),__builtin_bit_cast(Bits,b.hi),c);
+    c=__builtin_amdgcn_wmma_f32_16x16x16_bf16_w32(__builtin_bit_cast(Bits,a.hi),__builtin_bit_cast(Bits,b.lo),c);
+    c=__builtin_amdgcn_wmma_f32_16x16x16_bf16_w32(__builtin_bit_cast(Bits,a.hi),__builtin_bit_cast(Bits,b.hi),c);
+#endif
+}
+// A wave's accumulator has one value column per half-wave lane and owns the
+// even or odd key/time rows. Assemble the full ordered column and mirror it
+// across its two half-waves as the gfx11 B operand requires.
+__device__ __forceinline__ void set_column_pair(Operand &a,int i,unsigned local,int odd) {
+    const unsigned other=__builtin_amdgcn_permlanex16(local,local,0x76543210u,0xfedcba98u,false,false);
+    const unsigned hi=odd?0x01000504u:0x05040100u;
+    const unsigned lo=odd?0x03020706u:0x07060302u;
+    a.hi[i]=__builtin_amdgcn_perm(other,local,hi);
+    a.lo[i]=__builtin_amdgcn_perm(other,local,lo);
+}
+__device__ __forceinline__ Operand column(const Acc &x,int odd) {
+    Operand o;
+#pragma unroll
+    for(int i=0;i<8;i++) set_column_pair(o,i,split(x[i]),odd);
+    return o;
+}
+__device__ __forceinline__ Operand prepared_row(const uint16_t *h,const uint16_t *l,int row) {
+    Operand o;
+    __builtin_memcpy(&o.hi,h+C*row,sizeof(Words));
+    __builtin_memcpy(&o.lo,l+C*row,sizeof(Words));
+    return o;
+}
+
+__global__ __launch_bounds__(W*32) void register_scan_norm(Gdn a,const Prepared *all,Norm norm) {
+    const int tid=threadIdx.x, wave=tid/32, lane=tid%32, row=lane%16, odd=lane/16;
+    const int h=blockIdx.x/(8/W), vc=((blockIdx.x%(8/W))*W+wave)*C+row;
+    const int kh=h%16;
+    Acc state[8];
+#pragma unroll
+    for(int kt=0;kt<8;kt++)
+#pragma unroll
+        for(int i=0;i<8;i++)state[kt][i]=a.state[(h*D+vc)*D+kt*16+2*i+odd];
+
+    // Packed high and low BF16 per element. Padding separates banks for the
+    // transposed key read in the final state update.
+    __shared__ unsigned q[C][D+1], k[C][D+1];
+    __shared__ float raw[C][D+1];
+    __shared__ float decay[C], tail[C], beta[C], last_decay;
+    const int T=int(a.n_tokens);
+    for(int t0=0;t0<T;t0+=C) {
+        const int valid=min(C,T-t0);
+        const Prepared &chunk=all[(t0/C)*48+h];
+        if(tid<C) {
+            const float last=chunk.prefix[valid-1];
+            decay[tid]=expf(chunk.prefix[tid]);
+            tail[tid]=expf(last-chunk.prefix[tid]);
+            beta[tid]=chunk.beta[tid];
+            if(!tid)last_decay=expf(last);
+        }
+#pragma unroll
+        for(int i=0;i<C*D/(W*32);i++) {
+            const int off=i*W*32+tid, t=off/D, d=off%D;
+            const int index=(t0+t)*10240+kh*D+d;
+            q[t][d]=split_scaled_q(t<valid?a.q[index]:0.f,a.scale);
+            k[t][d]=split(t<valid?a.k[index]:0.f);
+        }
+        __syncthreads();
+        Acc qs{},ks{};
+#pragma unroll
+        for(int kt=0; kt<8;kt++) {
+            const Operand sb=column(state[kt],odd);
+            Operand aq,ak;
+#pragma unroll
+            for(int j=0;j<C/2;j++){
+                set_pair(aq,j,q[row][kt*C+2*j],q[row][kt*C+2*j+1]);
+                set_pair(ak,j,k[row][kt*C+2*j],k[row][kt*C+2*j+1]);
+            }
+            product(qs,aq,sb);
+            product(ks,ak,sb);
+        }
+        Operand delta;
+#pragma unroll
+        for(int i=0;i<8;i++){
+            const int t=2*i+odd;
+            const float v=t<valid?a.v[(t0+t)*10240+h*D+vc]:0.f;
+            const float x=beta[t]*(v-decay[t]*ks[i]);
+            set_column_pair(delta,i,split(x),odd);
+            // The accepted scan rounds this product before adding P*solved.
+            // The explicit VGPR boundary prevents contraction at the later store.
+            float rounded=qs[i]*decay[t];
+            asm volatile("" : "+v"(rounded));
+            qs[i]=rounded;
+        }
+        Acc solved{};
+        product(solved,prepared_row(chunk.inv_hi,chunk.inv_lo,row),delta);
+        Operand solved_b, weighted;
+#pragma unroll
+        for(int i=0;i<8;i++){
+            const unsigned sl=split(solved[i]);
+            set_column_pair(solved_b,i,sl,odd);
+            set_column_pair(weighted,i,split(join(sl)*tail[2*i+odd]),odd);
+        }
+        Acc out{};
+        product(out,prepared_row(chunk.p_hi,chunk.p_lo,row),solved_b);
+#pragma unroll
+        for(int i=0;i<8;i++){
+            const int t=2*i+odd;
+            raw[t][vc]=qs[i]+out[i];
+        }
+        __syncthreads();
+        // Each of eight waves owns a complete 128-value row at a time.
+        // The native precursor's XOR at lane wv is used for each 32-column group.
+        for(int t=wave;t<valid;t+=W) {
+            float x[4];
+            float second=0.0f;
+#pragma unroll
+            for(int group=0;group<4;group++) {
+                x[group]=raw[t][group*32+lane];
+                float squared=x[group]*x[group];
+                asm volatile("" : "+v"(squared));
+                const float subsum=xor_sum(squared);
+                if(lane==group) second=subsum;
+            }
+            float mean=xor_sum(second)/128.0f;
+            asm volatile("" : "+v"(mean));
+            const float scale=rsqrtf(mean+norm.eps);
+#pragma unroll
+            for(int group=0;group<4;group++) {
+                const int col=group*32+lane;
+                const size_t i=(size_t((t0+t)*48+h)*D)+col;
+                const float gated=(scale*x[group]*norm.weight[col])*(1.0f/(1.0f+expf(-norm.gate[i])));
+                if(norm.out) norm.out[i]=gated;
+                if(norm.out16) norm.out16[i]=pack_norm(gated,norm.fp16);
+            }
+        }
+#pragma unroll
+        for(int kt=0;kt<8;kt++){
+            Operand transposed;
+#pragma unroll
+            for(int j=0;j<C/2;j++)set_pair(transposed,j,k[2*j][kt*C+row],k[2*j+1][kt*C+row]);
+            state[kt]*=last_decay;
+            product(state[kt],transposed,weighted);
+        }
+        __syncthreads();
+    }
+#pragma unroll
+    for(int kt=0;kt<8;kt++)
+#pragma unroll
+        for(int i=0;i<8;i++)a.state_out[(h*D+vc)*D+kt*16+2*i+odd]=state[kt][i];
+}
+}
+extern "C" int repair_scan_norm(void **args,void *stream) {
+    if (!args || !args[0] || !args[1] || !args[2])return int(hipErrorInvalidValue);
+    Norm norm; std::memcpy(&norm,args[2],sizeof norm);
+    if(!norm.weight || !norm.gate || (!norm.out && !norm.out16)) return int(hipErrorInvalidValue);
+    Gdn a;std::memcpy(&a,args[0],sizeof a);
+    const Prepared *p;
+    std::memcpy(&p,args[1],sizeof(p));
+    if (!p || a.H!=48 || a.H_k!=16 || (a.n_tokens!=4092 && a.n_tokens!=4096) || a.n_seqs!=1 ||
+        a.sq1!=128 || a.sq2!=10240 || a.sv1!=128 || a.sv2!=10240 ||
+        !a.state || !a.state_out || !a.dst)return int(hipErrorInvalidValue);
+    register_scan_norm<<<48*(8/W),W*32,0,static_cast<hipStream_t>(stream)>>>(a,p,norm);
+    return int(hipGetLastError());
+}
