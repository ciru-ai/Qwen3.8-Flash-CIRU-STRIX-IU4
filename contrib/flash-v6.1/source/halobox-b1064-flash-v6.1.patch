@@ -0,0 +1,37 @@
+// Loaded in hyperconn.cu below the existing BF16 unpack and rounded mul/add helpers.
+static __device__ __forceinline__ void hc_load_routed_merge(
+        const ggml_cuda_hc_routed_merge & args, int token, int feature, int width, float (&merged)[8]) {
+    const int64_t first = (int64_t) token * args.routes;
+    const float first_scale = args.expert_scale ? args.expert_scale[first] : 1.0f;
+    const float first_weight = args.route_weights[first];
+    const uint4 values = *(const uint4 *)(args.experts + first * width + feature);
+    const uint32_t packed[] = {values.x, values.y, values.z, values.w};
+#pragma unroll
+    for (int i = 0; i < 4; ++i) {
+        merged[2 * i] = (hc_lo(packed[i]) * first_scale) * first_weight;
+        merged[2 * i + 1] = (hc_hi(packed[i]) * first_scale) * first_weight;
+    }
+
+    // Match SGMA's ordered route accumulation and its compiler contraction policy.
+    for (int expert = 1; expert < args.routes; ++expert) {
+        const int64_t row = first + expert;
+        const float scale = args.expert_scale ? args.expert_scale[row] : 1.0f;
+        const float weight = args.route_weights[row];
+        const uint4 values = *(const uint4 *)(args.experts + row * width + feature);
+        const uint32_t packed[] = {values.x, values.y, values.z, values.w};
+#pragma unroll
+        for (int i = 0; i < 4; ++i) {
+            merged[2 * i] += (hc_lo(packed[i]) * scale) * weight;
+            merged[2 * i + 1] += (hc_hi(packed[i]) * scale) * weight;
+        }
+    }
+
+    const float gate = 1.0f / (1.0f + expf(-args.shared_gate[token]));
+    const float4 * shared = (const float4 *)(args.shared_out + (int64_t) token * width + feature);
+    const float4 a = shared[0], b = shared[1];
+    const float values_shared[] = {a.x, a.y, a.z, a.w, b.x, b.y, b.z, b.w};
+#pragma unroll
+    for (int i = 0; i < 8; ++i) {
+        merged[i] = hc_add_rn(merged[i], hc_mul_rn(values_shared[i], gate));
+    }
+}
