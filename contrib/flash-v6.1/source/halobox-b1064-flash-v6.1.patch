+            memcmp(idx_truth.data(), idx, idx_truth.size() * sizeof(int32_t)) != 0) {
+        return false;
+    }
+    const auto wait_start = std::chrono::steady_clock::now();
+    cv.wait(lk, [&] { return expected != generation || stop_req || done || produced >= n; });
+    const auto wait_end = std::chrono::steady_clock::now();
+    if (expected != generation || stop_req || produced < n || consumed != 0) {
+        return false;
+    }
+    set(dst, ring.data(), (size_t) n * n_heads * dim * sizeof(float));
+    consumed = n;
+    ++st_ubatches;
+    st_hits += (uint64_t) n;
+    st_wait_ms += std::chrono::duration<double, std::milli>(wait_end - wait_start).count();
+    lk.unlock();
+    cv.notify_all();
