+++ b/ggml/src/ggml-cuda/qsa-assemble.cuh
@@ -0,0 +1,33 @@
+#pragma once
+#include "qsa-assemble.h"
+
+struct qsa_strip_sources { const int32_t * p[8]; };
+
+__global__ __launch_bounds__(256) void qsa_assemble_strips_8(qsa_strip_sources src, int32_t * dst) {
+    // The last strip holds 508 rows. Both 2051*512 and 2051*508 divide by 4,
+    // so the packed copy never crosses a strip boundary or the final row.
+    const int strip = blockIdx.y;
+    const int j = blockIdx.x*blockDim.x + threadIdx.x;
+    const int quads = (strip == 7 ? 508 : 512)*2051/4;
+    if (j >= quads) { return; }
+    const int32_t * in = src.p[strip];
+    int32_t * out = dst + strip*512*2051;
+    if (((uintptr_t(in) | uintptr_t(out)) & 15) == 0) {
+        reinterpret_cast<int4 *>(out)[j] = reinterpret_cast<const int4 *>(in)[j];
+    } else {
+        for (int k = 0; k < 4; ++k) { out[4*j+k] = in[4*j+k]; }
+    }
+}
+
+static void qsa_assemble_launch(ggml_backend_cuda_context & ctx, ggml_tensor * dst) {
+    qsa_strip_sources args;
+    for (int i = 0; i < 8; ++i) { args.p[i] = (const int32_t *) dst->src[i]->data; }
+    const ggml_cuda_kernel_launch_params launch(dim3((512*2051/4+255)/256,8),dim3(256),0,ctx.stream());
+    ggml_cuda_kernel_launch(qsa_assemble_strips_8,launch,args,(int32_t *)dst->data);
+    CUDA_CHECK(cudaGetLastError());
+    static std::atomic<size_t> calls{0};
+    const size_t call = calls.fetch_add(1,std::memory_order_relaxed)+1;
+    if (call%12 == 1 || call%12 == 0) {
+        std::fprintf(stderr,"CIRU_QSA_ASSEMBLE_8 call=%zu rows=4092 strips=8\n",call);
+    }
+}
diff --git a/ggml/src/ggml-cuda/qsa-assemble.h b/ggml/src/ggml-cuda/qsa-assemble.h
new file mode 100644
index 0000000000000000000000000000000000000000..9c9d24fc46efa70804a35358af01e1516e893cf1
--- /dev/null
+++ b/ggml/src/ggml-cuda/qsa-assemble.h
@@ -0,0 +1,45 @@
+#pragma once
+#include "ggml.h"
+#include "ggml-impl.h"
+#include <cstring>
+
+// This op owns eight graph dependencies. The ordinary GGML custom callback
+// also computes the exact result if the scheduler places the op on the CPU.
+static bool qsa_assemble_shape(const ggml_tensor * t, int rows) {
+    const size_t bytes = size_t(rows)*2051*sizeof(int32_t);
+    return t && t->type == GGML_TYPE_I32 && t->ne[0] == 2051 && t->ne[1] == rows &&
+            t->ne[2] == 1 && t->ne[3] == 1 && t->nb[0] == sizeof(int32_t) &&
+            t->nb[1] == 2051*sizeof(int32_t) && t->nb[2] == bytes && t->nb[3] == bytes;
+}
+
+static void qsa_assemble_cpu(ggml_tensor * dst, int ith, int nth, void *) {
+    for (int i = ith; i < 8; i += nth) {
+        const ggml_tensor * src = dst->src[i];
+        std::memcpy((char *)dst->data + size_t(i)*512*dst->nb[1],src->data,ggml_nbytes(src));
+    }
+}
+
+static ggml_tensor * qsa_assemble_make(ggml_context * ctx, ggml_tensor ** parts, size_t count) {
+    if (count != 8) { return nullptr; }
+    for (size_t i = 0; i < count; ++i) {
+        if (!qsa_assemble_shape(parts[i],i == 7 ? 508 : 512) || parts[i]->view_src ||
+                (parts[i]->flags & GGML_TENSOR_FLAG_OUTPUT)) {
+            return nullptr;
+        }
+    }
+    return ggml_custom_4d(ctx,GGML_TYPE_I32,2051,4092,1,1,parts,8,qsa_assemble_cpu,8,nullptr);
+}
+
+static bool qsa_assemble_supported(const ggml_tensor * dst) {
+    if (dst->op != GGML_OP_CUSTOM || !qsa_assemble_shape(dst,4092) || dst->view_src) { return false; }
+    ggml_custom_op_params params;
+    std::memcpy(&params,dst->op_params,sizeof(params));
+    if (params.fun != qsa_assemble_cpu || params.n_tasks != 8 || params.userdata) { return false; }
+    for (int i = 0; i < 8; ++i) {
+        if (!qsa_assemble_shape(dst->src[i],i == 7 ? 508 : 512)) { return false; }
+    }
+    for (int i = 8; i < GGML_MAX_SRC; ++i) {
+        if (dst->src[i]) { return false; }
+    }
+    return true;
+}
diff --git a/ggml/src/ggml-cuda/verifier-top20.cuh b/ggml/src/ggml-cuda/verifier-top20.cuh
new file mode 100644
index 0000000000000000000000000000000000000000..be05a889a1dc94c724068e845a512a9cbaaa63bd
--- /dev/null
+++ b/ggml/src/ggml-cuda/verifier-top20.cuh
@@ -0,0 +1,91 @@
+#include <rocprim/block/block_radix_sort.hpp>
+
+// The high 32 bits rank an FP32 logit. Any NaN or infinity ranks ahead of every
+// finite value, so the CPU can reject the entire row without a second GPU scan.
+static __device__ uint32_t verifier_order(uint32_t bits) {
+    if ((bits & 0x7f800000u) == 0x7f800000u) return UINT32_MAX;
+    if ((bits << 1) == 0) bits = 0;
+    return bits & 0x80000000u ? ~bits : bits ^ 0x80000000u;
+}
+
+struct verifier_mask { int32_t ids[8]; };
+
+template<int width, bool from_logits, bool final>
+static __global__ void __launch_bounds__(256) verifier_top21_tiles(
+        const uint32_t * logits, uint32_t * backup, const uint64_t * input,
+        uint64_t * output, uint32_t * pairs, verifier_mask mask) {
+    constexpr int vocab = 248320, threads = 256;
+    constexpr int items = final ? 1 : 4;
+    constexpr int tile = threads * items, tiles = (width + tile - 1)/tile;
+    using Sort = rocprim::block_radix_sort<uint64_t, threads, items>;
+    __shared__ typename Sort::storage_type storage;
+    uint64_t keys[items];
+    const int row = blockIdx.y;
+#pragma unroll
+    for (int i = 0; i < items; ++i) {
+        const int col = blockIdx.x*tile + i*threads + threadIdx.x;
+        uint64_t key = 0; // all finite FP32 keys rank above padding
+        if (col < width) {
+            if (from_logits) {
+                const uint32_t bits = logits[row*vocab + col];
+                backup[row*vocab + col] = bits;
+                uint32_t order = verifier_order(bits);
+                bool banned = false;
+#pragma unroll
+                for (int j=0; j<8; ++j) banned |= mask.ids[j] == col;
+                // Nonfinite wins even if masked: the CPU baseline must evaluate
+                // the original row in its original order for NaN handling.
+                if (order != UINT32_MAX && banned) order = 0;
+                key = (uint64_t(order) << 32) | uint32_t(col);
+            } else {
+                key = input[row*width + col];
+            }
+        }
+        keys[i] = key;
+    }
+    Sort().sort_desc(keys, storage, 32, 64);
+#pragma unroll
+    for (int i = 0; i < items; ++i) {
+        const int rank = threadIdx.x*items + i; // block_radix_sort's blocked output
+        if (rank < 21) {
+            if (final) {
+                const uint32_t id = uint32_t(keys[i]);
+                pairs[2*(row*21 + rank)] = id;
+                pairs[2*(row*21 + rank) + 1] = logits[row*vocab + id];
+            } else {
+                output[(row*tiles + blockIdx.x)*21 + rank] = keys[i];
+            }
+        }
+    }
+}
+
+// ctx owns the stream. The caller owns all device buffers and the pinned host
+// destination until that stream has completed, including across graph reuse.
+static bool ggml_cuda_verifier_top21(ggml_backend_t backend, const ggml_tensor *src,
+        void *raw, void *scratch, size_t scratch_bytes, void *host, const int32_t *ids, size_t count) {
+    constexpr int rows=3, vocab=248320, n0=(vocab+1023)/1024, n1=(n0*21+1023)/1024;
+    constexpr size_t first=rows*n0*21, second=rows*n1*21;
+    auto *ctx = static_cast<ggml_backend_cuda_context *>(backend->context);
+    auto *buf = src->view_src ? src->view_src->buffer : src->buffer;
+    if (count > 8 || (count && !ids) || !buf || buf->buft != ggml_backend_cuda_buffer_type(ctx->device) ||
+            !ggml_is_contiguous(src) || src->type != GGML_TYPE_F32 ||
+            src->ne[0]!=vocab || ggml_nrows(src)!=rows ||
+            scratch_bytes < (first+second+rows*21)*sizeof(uint64_t)) return false;
+    verifier_mask mask;
+    for (size_t j=0; j<8; ++j) mask.ids[j] = j<count ? ids[j] : -1;
+    ggml_cuda_set_device(ctx->device);
+    auto *logits=static_cast<const uint32_t *>(src->data);
+    auto *backup=static_cast<uint32_t *>(raw);
+    auto *level0=static_cast<uint64_t *>(scratch);
+    auto *level1=level0+first;
+    auto *pairs=reinterpret_cast<uint32_t *>(level1+second);
+    verifier_top21_tiles<vocab,true,false><<<dim3(n0,rows),256,0,ctx->stream()>>>(
+            logits,backup,nullptr,level0,nullptr,mask);
+    verifier_top21_tiles<n0*21,false,false><<<dim3(n1,rows),256,0,ctx->stream()>>>(
+            logits,nullptr,level0,level1,nullptr,mask);
+    verifier_top21_tiles<n1*21,false,true><<<dim3(1,rows),256,0,ctx->stream()>>>(
+            logits,nullptr,level1,nullptr,pairs,mask);
+    CUDA_CHECK(cudaGetLastError());
+    CUDA_CHECK(cudaMemcpyAsync(host,pairs,rows*21*sizeof(uint64_t),cudaMemcpyDeviceToHost,ctx->stream()));
+    return true;
+}
